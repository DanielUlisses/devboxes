#!/usr/bin/env bash
# Stop and destroy a client's devbox container. Only ever touches a container
# tagged devbox, in the devbox VMID range, whose hostname is the client's.
# First, inside the box, `devbox logout` deletes the box's SSH keys from
# GitHub and logs it out of tailscale. Its backup job, if any, goes first.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR/.. source=lib/pve.sh
source "$ROOT/lib/pve.sh"

usage() {
  cat <<EOF
Usage: devbox-destroy [--skip-logout] <client>

Stop and destroy the devbox container for <client> (see devbox-config) on
the client's \`host\`, or \$DEVBOX_HOST when it names none (one of the two
is required). Exits 0 when there is none. First runs
\`devbox logout\` in the box (starting it if stopped): deletes its SSH keys
from GitHub and logs it out of tailscale. Removes the box's backup job
first, if it has one (its backups stay on the storage). Last, removes it
from this machine: ssh config entries, herdr machine, host keys
(bin/devbox-host remove).

  --skip-logout  destroy without it, for a box too broken to run it; then
                 delete its keys (titled with its hostname) on GitHub by hand
EOF
}

# This machine's side of the box: its ssh config entries, herdr machine and
# host keys, so a box recreated under the same name starts clean.
remove_from_this_machine() {
  "$ROOT/bin/devbox-host" remove "$1" ||
    say "could not remove everything for $1 from this machine; retry with bin/devbox-host remove $1"
}

main() {
  local client="" logout=true
  while (($#)); do
    case "$1" in
      --skip-logout) logout=false ;;
      -h | --help) usage; exit 0 ;;
      -*) usage >&2; die "unknown option: $1" ;;
      *) [[ -z $client ]] || die "expected one client, got '$client' and '$1'"; client="$1" ;;
    esac
    shift
  done
  [[ -n $client ]] || { usage >&2; exit 1; }

  local config hostname vmid status
  config="$("$ROOT/bin/devbox-config" --json "$client")" || exit 1
  hostname="$(jq -r .hostname <<<"$config")"
  use_config_host "$config"
  vmid="$(find_devbox "$hostname")"
  if [[ -z $vmid ]]; then
    say "no $hostname on $DEVBOX_HOST; nothing to destroy"
    remove_from_this_machine "$client"
    exit 0
  fi

  assert_devbox "$vmid" "$hostname"
  # Left behind, the job would back up whichever box gets this VMID next.
  sync_backup_job "$hostname" "$vmid" '{"backup": false}' ||
    die "could not remove backup job $(backup_job_id "$hostname"); not destroying $hostname"
  status="$(pve pct status "$vmid")"
  if $logout; then
    if [[ $status != "status: running" ]]; then
      say "starting $hostname (VMID $vmid) to log it out"
      pve pct start "$vmid"
      status="status: running"
    fi
    say "logging $hostname out: GitHub keys, tailscale"
    # A box whose bootstrap never got as far as installing devbox has nothing to log out.
    pve pct exec "$vmid" -- bash -c '[[ ! -x /usr/local/bin/devbox ]] || exec /usr/local/bin/devbox logout' ||
      die "could not log $hostname out; fix it and retry, or pass --skip-logout"
  fi
  if [[ $status != "status: stopped" ]]; then
    say "stopping $hostname (VMID $vmid)"
    pve pct stop "$vmid"
  fi
  say "destroying $hostname (VMID $vmid) on $DEVBOX_HOST"
  pve pct destroy "$vmid"
  say "destroyed $hostname"
  remove_from_this_machine "$client"
}

main "$@"
