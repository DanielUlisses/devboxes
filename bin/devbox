#!/usr/bin/env bash
# The devbox command, run inside a devbox. `devbox bootstrap` sets up a fresh
# box (bootstrap.sh hands over to it) and ends with a sync. `devbox sync`
# converges the box to its client's resolved config: pacman packages, mise
# tools and cloned repos, then (once `finish` has run) `devbox update`. That
# config comes from the machine that created or last synced the box (kept in
# /var/lib/devbox/config.json), or, once gh is logged in, from the private
# devbox-clients repo. Both run as root, re-running themselves under sudo
# when needed. `devbox login`, `finish`, `update` and `logout` run as the box
# user (root hands them over): the manual logins, then the per-box key,
# skills and repos, bringing what those installed current, and the cleanup
# bin/devbox-destroy runs before destroying the box. `devbox rc` starts
# Claude Remote Control in a new herdr pane in ~/work. A role: runner box
# gets only base packages, Docker, Tailscale and op: no Claude, skills, nvim,
# mise tools, repos or git identity, and no finish or update.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE=/var/lib/devbox
# The last resolved config this box was given or resolved, as JSON.
CONFIG=$STATE/config.json
# The private repo holding the client files, cloned with gh once it is logged
# in.
CLIENTS_REPO=DanielUlisses/devbox-clients
CLIENTS_DIR=/opt/devbox-clients
USER_NAME=daniel
USER_HOME=/home/$USER_NAME
export LC_ALL=C # one collation for sort and comm

# Installed by bootstrap, and by sync when missing; sync never removes them.
# tree-sitter-cli builds nvim-treesitter's parsers (LazyVim otherwise fetches
# it through mason on nvim's first start, racing the parser installs).
BASE_PACKAGES=(base-devel git openssh sudo stow jq go-yq unzip less mise github-cli tailscale bash-completion starship zoxide neovim tree-sitter-cli ripgrep fd docker docker-buildx docker-compose)

# A runner box's base packages instead: no developer tooling. All of them are
# in BASE_PACKAGES too, so sync_packages never removes one.
RUNNER_PACKAGES=(git sudo jq go-yq unzip less mise tailscale docker docker-buildx docker-compose)

# mise tools every box gets, kept in the system config so the client's tools:
# list (the user config) can't drop them.
BASE_TOOLS='# Written by devbox (bootstrap and sync): tools every devbox gets.
[tools]
herdr = "latest"
1password = "latest"
node = "26"'

# A runner box's only mise tool, op, installed by root into RUNNER_MISE_DATA,
# outside any home, so ghrunner can run it too; /usr/local/bin/op links to it.
RUNNER_TOOLS='# Written by devbox sync: the tools of a runner box, installed into /opt/mise.
[tools]
1password = "latest"'
RUNNER_MISE_DATA=/opt/mise
# The system user the runners run as (ticket 03 adds them), and where `devbox
# login` keeps its 1Password service-account token: the directory root:ghrunner
# 750, the file root:ghrunner 640, so root owns both and only ghrunner (alone in
# its own group) can read the token. 640, not 600: a root-owned 600 file would
# shut ghrunner out.
RUNNER_USER=ghrunner
RUNNER_OP_DIR=/etc/ghrunner
RUNNER_OP_TOKEN_FILE=$RUNNER_OP_DIR/op-service-account-token
# Turns off systemd-resolved's LLMNR and mDNS listeners on a runner box.
RUNNER_RESOLVED_CONF=/etc/systemd/resolved.conf.d/devbox-runner.conf
RUNNER_TAILSCALE_TAG=tag:runner

# Global agent instructions, generated by bin/devbox-agent-instructions; the
# developer's own go in AGENT_LOCAL, which is never touched.
AGENT_FILES=("$USER_HOME/.claude/CLAUDE.md" "$USER_HOME/AGENTS.md")
AGENT_LOCAL=$USER_HOME/.claude/CLAUDE.local.md
AGENT_MARKER='<!-- Generated by devbox'

# Docker's daemon config; bootstrap sets its storage driver.
DOCKER_DAEMON=/etc/docker/daemon.json

# Stow packages under dotfiles/ in this repo.
DOTFILES_PACKAGES=(bash git)
# gh rewrites its own config.yml (gh auth login sets git_protocol), so it is
# copied once rather than linked into the root-owned checkout.
GH_CONFIG=dotfiles/gh/.config/gh/config.yml
# LazyVim writes into its config directory (lazy-lock.json, lazyvim.json), so
# it is copied too: files missing from the box are added, edits there are kept.
NVIM_CONFIG=dotfiles/nvim/.config/nvim

# GitHub scopes beyond gh's defaults: add and delete this box's SSH keys.
GH_SCOPES=(admin:public_key admin:ssh_signing_key)
TAILSCALE_TAG=tag:devbox
# Where `devbox login` keeps the client's 1Password service-account token.
OP_TOKEN_FILE=$USER_HOME/.config/op/service-account-token
SSH_KEY=$USER_HOME/.ssh/id_ed25519
# Azure DevOps takes only RSA keys for SSH, so boxes with Azure DevOps repos get
# a second key for it, registered there by hand.
ADO_HOST=ssh.dev.azure.com
ADO_KEY=$USER_HOME/.ssh/id_rsa_ado
# ssh.dev.azure.com's host key, pinned rather than trusted on first use. Its
# fingerprint, SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og, is the one
# Microsoft documents in "Use SSH key authentication" (Azure Repos).
ADO_HOST_KEY="$ADO_HOST ssh-rsa "
# Boxes with Azure DevOps repos also get az and its azure-devops extension, for
# `az repos pr create` in their clones.
AZ_PACKAGE=azure-cli
AZ_EXTENSION=azure-devops
WORK=$USER_HOME/work
# Clones of the skill repos, installed from there into ~/.claude.
SKILL_REPOS=$USER_HOME/.claude/skill-repos
# Owner of skill repos named without one.
SKILLS_OWNER=DanielUlisses
# Skills installed with the skills CLI (npx skills add, node from BASE_TOOLS)
# from a GitHub source, not cloned: skills: entry -> owner/repo. Each one was
# once the Claude plugin <entry>@claude-plugins-official, which install
# removes.
declare -A SKILL_NPX=([mattpocock-skills]=mattpocock/skills)
OLD_SKILL_MARKETPLACE=claude-plugins-official
# The GitHub head each SKILL_NPX source was last installed at, one file each.
SKILL_STAMPS=$USER_HOME/.local/state/devbox/skills
# herdr plugins every box gets: plugin id -> GitHub source (owner/repo[/subdir]).
declare -A HERDR_PLUGINS=([persiyanov.reviewr]=persiyanov/herdr-reviewr)
# Written by `devbox finish`; sync runs `devbox update` only once it exists.
FINISHED=$USER_HOME/.local/state/devbox/finished

usage() {
  cat <<EOF
Usage: devbox bootstrap
       devbox sync [--config-json <json>] [--no-pacman-upgrade]
       devbox login
       devbox finish
       devbox update [--config-json <json>] [--no-pacman-upgrade]
       devbox logout
       devbox rc [<name>]

Run inside a devbox.

  bootstrap  set up a fresh box (user $USER_NAME, base packages, docker, claude,
             herdr, 1Password CLI, gh, tailscale, mise, dotfiles), then sync
  sync       converge the box to its client's config: pull the devboxes
             repo and, once gh is logged in, $CLIENTS_REPO (before
             that, the last config the box was given), then install and
             remove pacman packages and mise tools, clone newly listed
             repos, and run update once finish has. --config-json applies
             a resolved config (bin/devbox-config --json) instead, without
             pulling; bin/devbox-sync uses it.
  login      the manual logins, interactive: tailscale, gh, the client's
             1Password service-account token, Claude; with Azure DevOps
             repos, az (device code) and its azure-devops extension
  finish     after login: this box's SSH key on GitHub (auth and signing),
             git identity and signing, agent instructions (~/.claude/CLAUDE.md
             and ~/AGENTS.md, which sync regenerates), skills (mattpocock's
             with npx skills), the herdr plugins (reviewr), repos;
             with Azure DevOps repos, a key for it to add there by hand
  update     after finish: bring current what finish and bootstrap installed
             (skills, plugins, herdr plugins, pacman -Syu unless
             --no-pacman-upgrade, mise "latest" tools, Claude Code, the
             azure-devops az extension, new gh/nvim config files, nvim
             plugins to lazy-lock.json); sync runs it
  logout     remove this box's SSH keys from GitHub and log out of az and
             tailscale (the Azure DevOps key is removed by hand; it says
             which); bin/devbox-destroy runs it
  rc         inside herdr, as $USER_NAME: open a pane beside this one in
             ~/work running Claude with Remote Control (claude
             --remote-control [<name>]), to pick up from the Claude app

On a role: runner box, bootstrap installs only base packages, docker,
tailscale and op; sync adds the $RUNNER_USER system user, masks sshd and
turns off LLMNR and mDNS; login asks only for tailscale ($RUNNER_TAILSCALE_TAG)
and $RUNNER_USER's 1Password service-account token. finish and update don't
apply.
EOF
}

die() {
  printf 'devbox: %s\n' "$*" >&2
  exit 1
}

say() {
  printf 'devbox: %s\n' "$*" >&2
}

# Runs a command as the box user, in their home, with their tools on PATH.
# Already the box user: runs it as is.
as_user() {
  ((EUID == 0)) || { "$@"; return; }
  runuser -u "$USER_NAME" -- env -C "$USER_HOME" HOME="$USER_HOME" USER="$USER_NAME" LOGNAME="$USER_NAME" \
    PATH="$USER_HOME/.local/bin:$USER_HOME/.local/share/mise/shims:/usr/local/bin:/usr/bin" \
    MISE_YES=1 "$@"
}

# Writes $2 to file $1 (mode $3) when its content differs; returns 1 when unchanged.
write_if_changed() {
  local file="$1" content="$2" mode="$3"
  [[ -f $file && $(<"$file") == "$content" ]] && return 1
  install -D -m "$mode" /dev/stdin "$file" <<<"$content"
}

# The role of resolved config $1: devbox or runner. A config stored before
# roles existed is a devbox's.
box_role() {
  jq -r '.role // "devbox"' <<<"$1"
}

# Fails unless $1 is a resolved config (devbox-config --json output).
check_config() {
  jq -e '(.hostname | type == "string") and ([.packages, .tools, .skills, .repos] | all(type == "array"))' \
    <<<"$1" >/dev/null 2>&1 || die "not a resolved config (want the output of devbox-config --json)"
}

# The last config this box was given or resolved, as JSON. Readable by the
# box user, without gh.
stored_config() {
  [[ -f $CONFIG ]] ||
    die "no config in $CONFIG: run bin/devbox-sync <client> from your machine, or devbox login then devbox sync"
  check_config "$(<"$CONFIG")"
  cat "$CONFIG"
}

# Clones or updates $CLIENTS_REPO in $CLIENTS_DIR, as the box user, with gh.
# Read only here, so it follows the remote's default branch, detached.
pull_clients() {
  if [[ ! -d $CLIENTS_DIR/.git ]]; then
    install -d -o "$USER_NAME" -g "$USER_NAME" "$CLIENTS_DIR"
    as_user gh repo clone "$CLIENTS_REPO" "$CLIENTS_DIR" -- -q || die "could not clone $CLIENTS_REPO"
  fi
  as_user git -C "$CLIENTS_DIR" fetch -q origin HEAD || die "could not fetch $CLIENTS_REPO"
  as_user git -C "$CLIENTS_DIR" -c advice.detachedHead=false checkout -q --detach FETCH_HEAD ||
    die "could not check out $CLIENTS_REPO"
}

# The client's resolved config, as JSON: from --config-json, or by pulling the
# repo's branch and resolving the client recorded at bootstrap from the
# private clients repo, which needs gh logged in; until then, the stored
# config. Whatever it resolves to is stored for the next sync.
resolve_config() {
  local json="$1" client branch
  if [[ -z $json ]]; then
    client="$(<"$STATE/client")"
    branch="$(<"$STATE/branch")"
    # Called in $(...), where set -e doesn't reach, so each step checks itself.
    git -C "$ROOT" fetch -q origin "$branch" || die "could not fetch $branch of the devboxes repo"
    git -C "$ROOT" -c advice.detachedHead=false checkout -q --detach FETCH_HEAD || die "could not check out $branch"
    if as_user gh auth status -h github.com &>/dev/null; then
      pull_clients
      json="$(DEVBOX_CLIENTS="$CLIENTS_DIR" "$ROOT/bin/devbox-config" --json "$client")" || exit 1
    else
      say "config: gh is not logged in (a runner box has none), so using the last config this box was given ($CONFIG)"
      json="$(stored_config)" || exit 1
    fi
  fi
  check_config "$json"
  write_if_changed "$CONFIG" "$json" 644 || true
  printf '%s\n' "$json"
}

# The base packages of role $1 missing from the box installed, all of them
# marked explicit, so removing a client package never takes a base one along.
base_packages() {
  local base=("${BASE_PACKAGES[@]}") missing=()
  [[ $1 != runner ]] || base=("${RUNNER_PACKAGES[@]}")
  mapfile -t missing < <(pacman -T -- "${base[@]}" || true)
  if ((${#missing[@]})); then
    say "base packages: installing ${missing[*]}"
    pacman -Syu --needed --noconfirm -- "${missing[@]}"
  fi
  pacman -D --asexplicit -q -- "${base[@]}" >/dev/null
}

# Pacman packages: install the listed ones that are missing; for the ones
# dropped since the last sync (recorded in $STATE/packages), mark them as
# dependencies and `pacman -Rns` those nothing else needs. Base packages stay.
# A config with Azure DevOps repos also wants $AZ_PACKAGE.
sync_packages() {
  local config="$1" want had missing=() dropped=() orphans=()
  want="$({
    jq -r '.packages[]' <<<"$config"
    [[ -z $(ado_orgs "$config") ]] || echo "$AZ_PACKAGE"
  } | sort -u)"
  had="$(sort -u "$STATE/packages" 2>/dev/null || true)"
  local -a wanted=()
  [[ -z $want ]] || mapfile -t wanted <<<"$want"
  local -a base=("${BASE_PACKAGES[@]}")
  [[ $(box_role "$config") != runner ]] || base=("${RUNNER_PACKAGES[@]}")

  if ((${#wanted[@]})); then
    # pacman -T prints the ones not installed.
    mapfile -t missing < <(pacman -T -- "${wanted[@]}" || true)
    if ((${#missing[@]})); then
      say "packages: installing ${missing[*]}"
      pacman -Syu --needed --noconfirm -- "${missing[@]}"
    fi
    # A listed package already there as a dependency becomes explicit, so a
    # later -Rns can't take it along.
    { pacman -Qdq -- "${wanted[@]}" 2>/dev/null || true; } | xargs -r pacman -D --asexplicit -q -- >/dev/null
  fi

  mapfile -t dropped < <(comm -13 <(printf '%s\n' "$want") <(printf '%s\n' "$had") |
    grep -vxF -f <(printf '%s\n' "${base[@]}") | grep . || true)
  ((${#dropped[@]} == 0)) || mapfile -t dropped < <(pacman -Qq -- "${dropped[@]}" 2>/dev/null || true)
  if ((${#dropped[@]})); then
    pacman -D --asdeps -q -- "${dropped[@]}" >/dev/null
    mapfile -t orphans < <(pacman -Qdtq | grep -xF -f <(printf '%s\n' "${dropped[@]}") || true)
    if ((${#orphans[@]})); then
      say "packages: removing ${orphans[*]}"
      pacman -Rns --noconfirm -- "${orphans[@]}"
    fi
    mapfile -t dropped < <(pacman -Qq -- "${dropped[@]}" 2>/dev/null || true)
    ((${#dropped[@]} == 0)) || say "packages: kept ${dropped[*]}: other packages need them"
  fi

  ((${#missing[@]} + ${#orphans[@]} + ${#dropped[@]})) || say "packages: up to date"
  mkdir -p "$STATE"
  printf '%s\n' "$want" | grep . >"$STATE/packages.new" || true
  mv "$STATE/packages.new" "$STATE/packages"
}

# The client's tools: list as a mise [tools] table. Repeated tools become a
# list of versions, the first one the default.
# shellcheck disable=SC2016 # jq program, not shell expansions
MISE_TOML='
"# Written by devbox sync from the client'"'"'s tools: list; edits are overwritten.",
"[tools]",
(reduce (.tools[] | capture("^(?<n>[^@]+)@(?<v>.+)$")) as $t ({}; .[$t.n] += [$t.v])
 | to_entries[]
 | "\(.key | tojson) = \(if (.value | length) == 1 then .value[0] else .value end | tojson)")
'

# mise tools: write the user config from tools:, then install what's missing
# and prune what no config references any more.
sync_tools() {
  local config="$1" toml file="$USER_HOME/.config/mise/config.toml"
  # Bootstrap writes it too; here, so boxes get tools added to it since.
  ! write_if_changed /etc/mise/config.toml "$BASE_TOOLS" 644 || say "tools: wrote /etc/mise/config.toml"
  toml="$(jq -r "$MISE_TOML" <<<"$config")"
  if [[ ! -f $file || $(<"$file") != "$toml" ]]; then
    as_user mkdir -p "${file%/*}"
    # tee reads the here-string on its stdin; the user can't reopen root's /dev/stdin.
    as_user tee "$file" >/dev/null <<<"$toml"
    say "tools: wrote ${file/#$USER_HOME/\~}"
  fi
  as_user mise install
  as_user mise prune --yes
}

# Whether repos: entry $1 is an Azure DevOps SSH URL (else GitHub owner/repo).
is_ado() {
  [[ $1 == "git@$ADO_HOST:"* ]]
}

# The Azure DevOps orgs in the config's repos, one per line.
ado_orgs() {
  jq -r --arg h "git@$ADO_HOST:v3/" '.repos[] | select(startswith($h)) | ltrimstr($h) | split("/")[0]' <<<"$1" | sort -u
}

# Tells the person to add the Azure DevOps key ($ADO_KEY.pub) in each org.
ado_key_instructions() {
  local config="$1" title org
  title="$(jq -r .hostname <<<"$config")"
  say "azure devops: add this box's key by hand: Azure DevOps -> User settings -> SSH public keys -> + New Key,"
  say "azure devops: titled '$title', with this public key:"
  cat "$ADO_KEY.pub" >&2
  while IFS= read -r org; do
    say "azure devops: $org: https://dev.azure.com/$org/_usersSettings/keys"
  done < <(ado_orgs "$config")
  say "azure devops: then run devbox sync (or devbox finish) to clone its repos"
}

# Clones Azure DevOps repo $1 into $2 over SSH with the box's Azure DevOps key.
# Returns 2, leaving nothing behind, when Azure DevOps refuses the key (not
# added there yet); 1 on any other failure, with git's error shown.
clone_ado() {
  local repo="$1" dest="$2" err
  # BatchMode: fail rather than prompt, as sync runs with no one to answer.
  if err="$(as_user env GIT_SSH_COMMAND="ssh -o BatchMode=yes" git clone -q "$repo" "$dest" 2>&1)"; then
    return 0
  fi
  if grep -qE 'Public key authentication failed|Permission denied \(publickey' <<<"$err"; then
    return 2
  fi
  printf '%s\n' "$err" >&2
  return 1
}

# owner/repo of a clone's origin, lowercased (GitHub names ignore case). An
# Azure DevOps origin stays its SSH URL, lowercased.
# Read as the box user, who owns the clones: as root (devbox sync) git refuses
# them as "dubious ownership".
origin_repo() {
  as_user git -C "$1" remote get-url origin 2>/dev/null |
    sed -E 's#^(https://github\.com/|git@github\.com:)##; s#\.git$##' | tr '[:upper:]' '[:lower:]'
}

# repos: clones listed repos missing from ~/work (as <repo>); clones no longer
# listed are only reported, never removed. GitHub repos need gh logged in;
# Azure DevOps ones need the box's Azure DevOps key, made by `devbox finish`
# and added there by hand: until then they are reported pending, and the
# GitHub ones still clone. Fails, after trying every repo, when an Azure
# DevOps clone fails for another reason.
sync_repos() {
  local config="$1" repo dest dir cloned=0 listed gh_ok=true pending=() failed=0 status
  as_user gh auth status -h github.com &>/dev/null || gh_ok=false
  as_user mkdir -p "$WORK"
  listed="$(jq -r '.repos[] | ascii_downcase' <<<"$config")"
  while IFS= read -r repo; do
    dest="$WORK/${repo##*/}"
    if [[ -e $dest ]]; then
      [[ $(origin_repo "$dest") == "${repo,,}" ]] ||
        say "repos: not cloning $repo: ${dest/#$USER_HOME/\~} holds $(origin_repo "$dest" || echo "something else")"
      continue
    fi
    if ! is_ado "$repo"; then
      if ! $gh_ok; then
        say "repos: skipped $repo, gh is not logged in (devbox login, then devbox finish)"
        continue
      fi
      say "repos: cloning $repo into ${dest/#$USER_HOME/\~}"
      as_user gh repo clone "$repo" "$dest" -- -q
      cloned=$((cloned + 1))
    elif [[ ! -f $ADO_KEY ]]; then
      say "repos: pending $repo: no Azure DevOps key yet (devbox finish makes it)"
      pending+=("$repo")
    else
      status=0
      clone_ado "$repo" "$dest" || status=$?
      case $status in
        0) say "repos: cloned $repo into ${dest/#$USER_HOME/\~}"; cloned=$((cloned + 1)) ;;
        2) say "repos: pending $repo: Azure DevOps refused the key (not added there yet)"; pending+=("$repo") ;;
        *) say "repos: could not clone $repo (above)"; failed=1 ;;
      esac
    fi
  done < <(jq -r '.repos[]' <<<"$config")
  ((${#pending[@]} == 0)) || [[ ! -f $ADO_KEY ]] || ado_key_instructions "$config"
  for dir in "$WORK"/*; do
    [[ -d $dir/.git ]] || continue
    repo="$(origin_repo "$dir")"
    grep -qxF -- "$repo" <<<"$listed" ||
      say "repos: ${dir/#$USER_HOME/\~} ($repo) is no longer listed; left in place"
  done
  ((cloned + ${#pending[@]} + failed)) || say "repos: up to date"
  ((failed == 0))
}

# Points /etc/localtime at the config's zone. timedatectl too when systemd
# runs; a container may refuse to set the clock, but the zone is a file.
sync_timezone() {
  local zone
  zone="$(jq -r '.timezone // "UTC"' <<<"$1")"
  [[ -f /usr/share/zoneinfo/$zone ]] || die "timezone: no zone $zone in /usr/share/zoneinfo"
  if [[ $(readlink /etc/localtime 2>/dev/null) == "/usr/share/zoneinfo/$zone" ]] &&
    [[ $(cat /etc/timezone 2>/dev/null) == "$zone" ]]; then
    return
  fi
  say "timezone: $zone"
  ln -sfn "/usr/share/zoneinfo/$zone" /etc/localtime
  printf '%s\n' "$zone" >/etc/timezone
  if [[ -d /run/systemd/system ]]; then
    timedatectl set-timezone "$zone" 2>/dev/null || say "timezone: timedatectl refused; /etc/localtime is set"
  fi
}

# A runner box's op: mise, as root, installs the 1password tool from
# RUNNER_TOOLS into RUNNER_MISE_DATA, which every user can read (ghrunner can't
# read a home), upgrades it (quietly: a new version shows as the relink) so op
# doesn't go stale, and /usr/local/bin/op links to it.
runner_op() {
  local op
  ! write_if_changed /etc/mise/config.toml "$RUNNER_TOOLS" 644 || say "op: wrote /etc/mise/config.toml"
  env -C / MISE_DATA_DIR="$RUNNER_MISE_DATA" MISE_YES=1 mise install
  env -C / MISE_DATA_DIR="$RUNNER_MISE_DATA" MISE_YES=1 mise upgrade --quiet 1password
  op="$(env -C / MISE_DATA_DIR="$RUNNER_MISE_DATA" mise which op)" || die "op: mise installed no op"
  if [[ $(readlink /usr/local/bin/op 2>/dev/null) != "$op" ]]; then
    ln -sfn "$op" /usr/local/bin/op
    say "op: /usr/local/bin/op -> $op"
  fi
}

# A runner box's lockdown, converged by sync (a re-run changes nothing): the
# RUNNER_USER system user, outside wheel; every home closed to other users;
# sshd masked, as Tailscale SSH serves the tailnet; systemd-resolved's LLMNR
# and mDNS off. Then says what still listens beyond loopback and the tailnet.
runner_setup() {
  local home unit listeners changed=false
  if ! id "$RUNNER_USER" &>/dev/null; then
    useradd --system --user-group --create-home --home-dir "/home/$RUNNER_USER" --shell /usr/bin/nologin "$RUNNER_USER"
    say "runner: added system user $RUNNER_USER"
    changed=true
  fi
  if id -nG "$RUNNER_USER" | grep -qw wheel; then
    gpasswd -d "$RUNNER_USER" wheel >/dev/null
    say "runner: took $RUNNER_USER out of wheel"
    changed=true
  fi
  for home in /home/*/; do
    [[ -d $home && $(stat -c %a "$home") != 700 ]] || continue
    chmod 700 "$home"
    say "runner: closed ${home%/} to other users (700)"
    changed=true
  done

  if [[ -d /run/systemd/system ]]; then
    # Masked rather than disabled: nothing can start it again, even once
    # openssh is installed.
    for unit in sshd.service sshd.socket; do
      [[ $(systemctl is-enabled "$unit" 2>/dev/null) != masked ]] || continue
      systemctl mask "$unit" >/dev/null || die "runner: could not mask $unit"
      systemctl stop "$unit" 2>/dev/null || true
      say "runner: masked $unit; Tailscale SSH serves the tailnet"
      changed=true
    done
    if write_if_changed "$RUNNER_RESOLVED_CONF" $'[Resolve]\nLLMNR=no\nMulticastDNS=no' 644; then
      systemctl try-restart systemd-resolved.service
      say "runner: LLMNR and mDNS off ($RUNNER_RESOLVED_CONF)"
      changed=true
    fi
  else
    say "runner: no systemd, sshd and systemd-resolved left as they are"
  fi
  $changed || say "runner: up to date"

  # tailscaled's own WireGuard port listens everywhere, but takes only tailnet
  # peers' packets, and systemd-networkd's DHCP client sockets only answer
  # the leases it asked for; anything else listening beyond loopback and the
  # tailnet is reported.
  listeners="$(ss -Htulnp | grep -vE '"(tailscaled|systemd-network)"' |
    awk '$5 !~ /^(127\.|\[::1\]|100\.|\[fd7a:115c:a1e0:)/ {print $1 " " $5}' | sort -u | paste -sd, -)" || true
  if [[ -n $listeners ]]; then
    say "runner: warning: listening beyond loopback and the tailnet: $listeners"
  else
    say "runner: nothing listens beyond loopback and the tailnet (tailscaled's WireGuard port and networkd's DHCP client aside)"
  fi
}

# $2: --no-pacman-upgrade, passed on to update, or empty.
sync() {
  local config no_upgrade="${2:-}" before role
  before="$(git -C "$ROOT" rev-parse HEAD)"
  config="$(resolve_config "${1:-}")"
  # The pull may have changed this script, and this run is still the old one:
  # re-run the new one on the config just resolved (--config-json doesn't pull).
  if [[ -z ${1:-} && $(git -C "$ROOT" rev-parse HEAD) != "$before" ]]; then
    exec "$ROOT/bin/devbox" sync --config-json "$(jq -c . <<<"$config")" ${no_upgrade:+"$no_upgrade"}
  fi
  role="$(box_role "$config")"
  base_packages "$role"
  sync_timezone "$config"
  sync_packages "$config"
  if [[ $role == runner ]]; then
    runner_op
    runner_setup
    say "synced (runner box)"
    return
  fi
  sync_tools "$config"
  # Before the repos, so a failed clone doesn't hold back an identity change.
  if [[ -f $FINISHED ]]; then
    git_identity "$config"
    agent_instructions "$config"
  fi
  sync_repos "$config"
  # Runs the checkout's devbox, which the pull above may have just changed.
  if [[ ! -f $FINISHED ]]; then
    say "update: skipped until devbox finish has run"
  elif ! as_user "$ROOT/bin/devbox" update --config-json "$(jq -c . <<<"$config")" ${no_upgrade:+"$no_upgrade"}; then
    die "synced, but some update steps failed (above)"
  fi
  say "synced"
}

gh_logged_in() {
  gh auth status -h github.com &>/dev/null
}

tailscale_up() {
  tailscale status --json 2>/dev/null | jq -e '.BackendState == "Running"' >/dev/null
}

# Whether gh's token has every scope in GH_SCOPES.
gh_has_scopes() {
  local have scope
  have="$(gh api -i user 2>/dev/null | tr -d '\r' | sed -n 's/^[Xx]-[Oo][Aa]uth-[Ss]copes: //p' | tr -d ' ' | tr ',' '\n')"
  for scope in "${GH_SCOPES[@]}"; do
    grep -qxF "$scope" <<<"$have" || return 1
  done
}

# With several tenants on the az login, asks which one holds the Azure DevOps
# orgs and makes it the default, which the azure-devops extension tries first.
az_pick_tenant() {
  local accounts tenants=() i choice
  accounts="$(az account list -o json)"
  mapfile -t tenants < <(jq -r 'map(.tenantId) | unique[]' <<<"$accounts")
  ((${#tenants[@]} > 1)) || return 0
  say "az: this login reaches ${#tenants[@]} tenants; pick the one holding the Azure DevOps orgs:"
  for i in "${!tenants[@]}"; do
    printf '  %d) %s\n' $((i + 1)) "$(jq -r --arg t "${tenants[i]}" \
      'first(.[] | select(.tenantId == $t)) | "\(.tenantDisplayName // .tenantDefaultDomain // "?") (\(.tenantId))"' \
      <<<"$accounts")" >&2
  done
  while :; do
    read -rp "tenant [1-${#tenants[@]}]: " choice
    [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#tenants[@]})) && break
  done
  az account set --subscription "$(jq -r --arg t "${tenants[choice - 1]}" \
    'first(.[] | select(.tenantId == $t)) | .id' <<<"$accounts")"
  say "az: default tenant ${tenants[choice - 1]}"
}

# For a config with Azure DevOps repos: az logged in, with a device code as the
# box has no browser, and the azure-devops extension added. `az repos` then
# reads a clone's org, project and repo from its origin remote.
az_login() {
  local config="$1" orgs
  orgs="$(ado_orgs "$config" | paste -sd, | sed 's/,/, /g')"
  [[ -n $orgs ]] || return 0
  command -v az >/dev/null || die "az: not installed; run devbox sync (it installs $AZ_PACKAGE), then devbox login"
  if az account show &>/dev/null; then
    say "az: already logged in as $(az account show --query user.name -o tsv)"
  else
    say "az: log in with the account that reaches $orgs"
    # Off: az's own subscription picker; az_pick_tenant asks for the tenant.
    AZURE_CORE_LOGIN_EXPERIENCE_V2=off az login --use-device-code --allow-no-subscriptions --only-show-errors >/dev/null
    az_pick_tenant
  fi
  add_az_extension || say "az: $AZ_EXTENSION extension already added"
}

# Adds the $AZ_EXTENSION az extension; returns 1 when it is already there.
add_az_extension() {
  az extension show --name "$AZ_EXTENSION" &>/dev/null && return 1
  az extension add --name "$AZ_EXTENSION" --only-show-errors
  changed "az: added the $AZ_EXTENSION extension"
}

# Validates a service-account token with op whoami. Right after tailscale up,
# op's own resolver fails on MagicDNS for a while even when getent resolves,
# so retry for up to a minute while the error is a lookup or dial one; any
# other error (a bad token) fails at once.
op_check_token() {
  local err net='lookup |dial tcp|server misbehaving|no such host|i/o timeout|network is unreachable|connection refused'
  for _ in {1..30}; do
    err="$(OP_SERVICE_ACCOUNT_TOKEN="$1" op whoami 2>&1 >/dev/null)" && return
    grep -qiE "$net" <<<"$err" || { printf '%s\n' "$err" >&2; die "1password: op rejected the token; not stored"; }
    sleep 2
  done
  printf '%s\n' "$err" >&2
  die "1password: op still can't reach 1Password after a minute; token not stored, re-run devbox login"
}

# Joins the tailnet as tag $1, with Tailscale SSH, unless already up.
tailscale_join() {
  if tailscale_up; then
    say "tailscale: already up"
    # Boxes joined before --accept-dns=false: hand DNS back to the box.
    sudo tailscale set --accept-dns=false
  else
    say "tailscale: open the URL below to add this box to the tailnet"
    # --accept-dns=false: a box never connects out to the tailnet, so it needs
    # no MagicDNS, and taking over its resolv.conf left public names failing
    # (SERVFAIL) wherever MagicDNS had no upstream to forward them to.
    sudo tailscale up --ssh --advertise-tags="$1" --accept-dns=false
  fi
}

# Asks for a 1Password service-account token (hidden) and prints it, cleaned
# up; empty when the person skips it.
read_op_token() {
  local token
  say "1password: paste the $(<"$STATE/client") service-account token (hidden; empty skips)"
  IFS= read -rs token
  # A paste through Windows terminals and ssh can carry a CR or spaces, and
  # bracketed-paste markers (ESC[200~ ... ESC[201~): keep only the
  # characters a token is made of.
  token="${token//$'\e[200~'/}"
  token="${token//$'\e[201~'/}"
  printf '\n' >&2
  LC_ALL=C tr -cd 'A-Za-z0-9_=+/.-' <<<"$token"
}

# A runner box's logins: tailscale as RUNNER_TAILSCALE_TAG, then the runner's
# 1Password token, checked with op whoami and stored for RUNNER_USER only
# (see RUNNER_OP_TOKEN_FILE). No gh, Claude or az.
runner_login() {
  local token
  id "$RUNNER_USER" &>/dev/null || die "no $RUNNER_USER user yet: run devbox sync, then devbox login"
  tailscale_join "$RUNNER_TAILSCALE_TAG"
  if sudo test -s "$RUNNER_OP_TOKEN_FILE"; then
    say "1password: $RUNNER_USER's service-account token already stored"
  else
    token="$(read_op_token)"
    if [[ -z $token ]]; then
      say "1password: skipped"
    else
      op_check_token "$token"
      sudo install -d -o root -g "$RUNNER_USER" -m 750 "$RUNNER_OP_DIR"
      # From stdin, so the token never shows in a process list.
      sudo install -o root -g "$RUNNER_USER" -m 640 /dev/stdin "$RUNNER_OP_TOKEN_FILE" <<<"$token"
      say "1password: token stored in $RUNNER_OP_TOKEN_FILE (root:$RUNNER_USER, mode 640)"
    fi
  fi
  say "logged in (runner box: no finish)"
}

# The manual logins. Each step skips when already done, so re-running only
# asks for what's missing.
login() {
  local config account token scopes
  config="$(stored_config)" || exit 1
  if [[ $(box_role "$config") == runner ]]; then
    runner_login
    return
  fi
  account="$(jq -r .claude_account <<<"$config")"
  scopes="$(IFS=,; echo "${GH_SCOPES[*]}")"

  tailscale_join "$TAILSCALE_TAG"

  if ! gh_logged_in; then
    say "gh: log in to GitHub"
    gh auth login -h github.com -p https -w -s "$scopes"
  elif ! gh_has_scopes; then
    say "gh: adding the $scopes scopes (for this box's SSH keys)"
    gh auth refresh -h github.com -s "$scopes"
  else
    say "gh: already logged in"
  fi

  if [[ -s $OP_TOKEN_FILE ]]; then
    say "1password: service-account token already stored"
  else
    token="$(read_op_token)"
    if [[ -z $token ]]; then
      say "1password: skipped"
    else
      op_check_token "$token"
      (umask 077 && mkdir -p "${OP_TOKEN_FILE%/*}" && printf '%s\n' "$token" >"$OP_TOKEN_FILE")
      chmod 600 "$OP_TOKEN_FILE"
      say "1password: token stored in ${OP_TOKEN_FILE/#$USER_HOME/\~}"
    fi
  fi

  if claude auth status --json 2>/dev/null | jq -e .loggedIn >/dev/null; then
    say "claude: logged in as $(claude auth status --json | jq -r '.email // "?"'); this box's account is '$account'"
  else
    say "claude: log in with the '$account' account"
    claude auth login
  fi

  az_login "$config"
  say "logged in; next: devbox finish"
}

# Writes the agent instructions for the config to each of AGENT_FILES, as the
# box user, when they differ. A file there that devbox didn't generate is moved
# aside first: to AGENT_LOCAL (which the instructions reference) when that is
# free, else to <file>.bak. Runs as the box user or as root (devbox sync).
agent_instructions() {
  local config="$1" text file
  text="$("$ROOT/bin/devbox-agent-instructions" <<<"$config")" || die "agents: could not generate the instructions"
  for file in "${AGENT_FILES[@]}"; do
    if [[ -f $file && $(head -c ${#AGENT_MARKER} "$file") != "$AGENT_MARKER" ]]; then
      if [[ $file == */CLAUDE.md && ! -e $AGENT_LOCAL ]]; then
        as_user mv "$file" "$AGENT_LOCAL"
        say "agents: moved your ${file/#$USER_HOME/\~} to ${AGENT_LOCAL/#$USER_HOME/\~}"
      else
        as_user mv "$file" "$file.bak"
        say "agents: moved your ${file/#$USER_HOME/\~} aside to ${file##*/}.bak"
      fi
    fi
    [[ ! -f $file || $(<"$file") != "$text" ]] || continue
    as_user mkdir -p "${file%/*}"
    # tee reads the here-string on its stdin; the user can't reopen root's /dev/stdin.
    as_user tee "$file" >/dev/null <<<"$text"
    say "agents: wrote ${file/#$USER_HOME/\~}"
  done
}

# Registers this box's public key on GitHub as $1 (keys or ssh_signing_keys)
# unless it's there already.
register_key() {
  local kind="$1" type="$2" title="$3" key
  key="$(cut -d' ' -f1,2 "$SSH_KEY.pub")"
  if gh api --paginate "user/$kind" | jq -e --arg k "$key" '.[] | select(.key == $k)' >/dev/null; then
    say "ssh key: already on GitHub for $type"
  else
    gh ssh-key add "$SSH_KEY.pub" --title "$title" --type "$type"
  fi
}

# Sets git config $2 to $3 in ~/.gitconfig.local, as the box user, unless it
# already is; returns 1 when unchanged.
set_git_config() {
  local file=$USER_HOME/.gitconfig.local
  [[ $(as_user git config -f "$file" "$1" 2>/dev/null) != "$2" ]] || return 1
  as_user git config -f "$file" "$1" "$2" || die "git: could not set $1 in $file"
}

# Git identity and SSH signing, in ~/.gitconfig.local, with the allowed-signers
# entry for the email. The client's git_name and git_email win over what is
# there; left empty, what is there is kept, or your GitHub name and noreply
# address are set. Runs as the box user or as root (devbox sync).
git_identity() {
  local config="$1" file=$USER_HOME/.gitconfig.local signers=$USER_HOME/.config/git/allowed_signers
  local name email entry changed=false
  name="$(jq -r '.git_name // ""' <<<"$config")"
  email="$(jq -r '.git_email // ""' <<<"$config")"
  [[ -n $name ]] || name="$(as_user git config -f "$file" user.name 2>/dev/null)" ||
    name="$(as_user gh api user --jq 'if (.name // "") == "" then .login else .name end')"
  [[ -n $email ]] || email="$(as_user git config -f "$file" user.email 2>/dev/null)" ||
    email="$(as_user gh api user --jq '"\(.id)+\(.login)@users.noreply.github.com"')"
  set_git_config user.name "$name" && changed=true
  set_git_config user.email "$email" && changed=true
  set_git_config gpg.format ssh || true
  set_git_config user.signingkey "$SSH_KEY.pub" || true
  set_git_config commit.gpgsign true || true
  set_git_config tag.gpgsign true || true
  set_git_config gpg.ssh.allowedSignersFile "$signers" || true
  entry="$email $(cut -d' ' -f1,2 "$SSH_KEY.pub")"
  if [[ ! -f $signers || $(<"$signers") != "$entry" ]]; then
    # tee reads the here-string on its stdin; the user can't reopen root's /dev/stdin.
    as_user mkdir -p "${signers%/*}"
    as_user tee "$signers" >/dev/null <<<"$entry"
    changed=true
  fi
  if $changed; then
    say "git: signing commits as $name <$email> (${file/#$USER_HOME/\~})"
  else
    say "git: identity up to date ($name <$email>)"
  fi
}

# For a config with Azure DevOps repos: the box's Azure DevOps key (RSA, which
# is all Azure DevOps takes), ssh using only that key for $ADO_HOST, and its
# host key pinned in known_hosts. Registering the key is left to a person.
ado_setup() {
  local config="$1" title="$2" ssh_config=$USER_HOME/.ssh/config known=$USER_HOME/.ssh/known_hosts
  [[ -n $(ado_orgs "$config") ]] || return 0
  if [[ -f $ADO_KEY ]]; then
    say "azure devops: ${ADO_KEY/#$USER_HOME/\~} exists"
  else
    ssh-keygen -q -t rsa -b 4096 -N '' -C "$title" -f "$ADO_KEY"
    say "azure devops: generated ${ADO_KEY/#$USER_HOME/\~}"
  fi
  if ! grep -qxF "$ADO_HOST_KEY" "$known" 2>/dev/null; then
    printf '%s\n' "$ADO_HOST_KEY" >>"$known"
    say "azure devops: pinned $ADO_HOST's host key in ${known/#$USER_HOME/\~}"
  fi
  # Azure DevOps fails on the first key it doesn't know rather than trying the
  # next, so ssh offers it only this one.
  if ! grep -qxF "Host $ADO_HOST" "$ssh_config" 2>/dev/null; then
    printf '\nHost %s\n  IdentityFile %s\n  IdentitiesOnly yes\n  StrictHostKeyChecking yes\n' \
      "$ADO_HOST" "${ADO_KEY/#$USER_HOME/\~}" >>"$ssh_config"
    chmod 600 "$ssh_config"
    say "azure devops: ssh uses ${ADO_KEY/#$USER_HOME/\~} for $ADO_HOST (${ssh_config/#$USER_HOME/\~})"
  fi
}

# Reports a change made by an update step (see run_step); outside update it
# just says it.
CHANGES=""
changed() {
  say "$*"
  [[ -z $CHANGES ]] || printf '\n' >>"$CHANGES"
}

# Installs plugin $1 (<plugin>@<marketplace>) unless it is installed.
install_plugin() {
  claude plugin list --json | jq -e --arg id "$1" '.[] | select(.id == $id)' >/dev/null && return
  claude plugin install "$1" >/dev/null
  changed "skills: installed plugin $1"
}

# Adds the marketplace at source $2 (named $1) unless it is configured.
add_marketplace() {
  claude plugin marketplace list --json | jq -e --arg n "$1" '.[] | select(.name == $n)' >/dev/null ||
    claude plugin marketplace add "$2"
}

# Clones (or fast-forwards) a skill repo into ~/.claude/skill-repos and,
# unless the commit it last installed is still its head, installs it the way
# its layout says: its own install.sh, a plugin marketplace, or a single skill
# (SKILL.md at the root) linked into ~/.claude/skills. The installed commit is
# kept in the clone's .git/devbox-installed, so a failed install is retried.
install_skill_repo() {
  local repo="$1" dest="$SKILL_REPOS/${1#*/}" market plugin head installed=""
  local stamp="$dest/.git/devbox-installed"
  if [[ -d $dest/.git ]]; then
    git -C "$dest" pull -q --ff-only || say "skills: could not update ${dest/#$USER_HOME/\~}; using it as is"
  else
    say "skills: cloning $repo"
    mkdir -p "$SKILL_REPOS"
    gh repo clone "$repo" "$dest" -- -q
  fi
  head="$(git -C "$dest" rev-parse HEAD)"
  [[ ! -f $stamp ]] || installed="$(<"$stamp")"
  [[ $installed != "$head" ]] || return 0

  if [[ -f $dest/install.sh ]]; then
    bash "$dest/install.sh" >/dev/null
  elif [[ -f $dest/.claude-plugin/marketplace.json ]]; then
    market="$(jq -r .name "$dest/.claude-plugin/marketplace.json")"
    add_marketplace "$market" "$dest"
    # Already added: re-read it, so plugins new in the repo can be installed.
    [[ -z $installed ]] || claude plugin marketplace update "$market" >/dev/null
    while IFS= read -r plugin; do
      install_plugin "$plugin@$market"
    done < <(jq -r '.plugins[].name' "$dest/.claude-plugin/marketplace.json")
  elif [[ -f $dest/SKILL.md ]]; then
    mkdir -p "$USER_HOME/.claude/skills"
    ln -sfn "$dest" "$USER_HOME/.claude/skills/$(basename "$dest" -skill)"
  else
    die "skills: don't know how to install $repo (no install.sh, .claude-plugin/marketplace.json or SKILL.md)"
  fi
  printf '%s\n' "$head" >"$stamp"
  if [[ -z $installed ]]; then
    changed "skills: installed $repo"
  else
    changed "skills: updated $repo (${installed:0:7}..${head:0:7})"
  fi
}

# Installs the HERDR_PLUGINS missing from herdr, and reinstalls those whose
# GitHub default branch has moved past the installed commit: herdr has no
# plugin update, and a reinstall keeps the plugin's config. A plugin linked
# from a local checkout is left alone.
herdr_plugins() {
  local id src installed head
  for id in "${!HERDR_PLUGINS[@]}"; do
    src="${HERDR_PLUGINS[$id]}"
    installed="$(herdr plugin list --json |
      jq -r --arg id "$id" '.result.plugins[] | select(.plugin_id == $id) | .source.resolved_commit // "local"')"
    [[ $installed != local ]] || continue
    head=""
    if [[ -n $installed ]]; then
      head="$(git ls-remote "https://github.com/$(cut -d/ -f1,2 <<<"$src").git" HEAD | cut -f1)"
      [[ -n $head ]] || die "herdr: can't read the head of $src"
      [[ $head != "$installed" ]] || continue
    fi
    herdr plugin install --yes "$src" </dev/null >/dev/null
    if [[ -z $installed ]]; then
      changed "herdr: installed plugin $id"
    else
      changed "herdr: updated plugin $id (${installed:0:7} -> ${head:0:7})"
    fi
  done
}

# Installs skill entry $1 from SKILL_NPX with the skills CLI, every skill in
# its source, into ~/.claude/skills, when the source's GitHub head moved since
# the last install; the Claude plugin it used to come as is uninstalled first.
install_skill_npx() {
  local skill="$1" src="${SKILL_NPX[$1]}" old="$1@$OLD_SKILL_MARKETPLACE"
  local stamp="$SKILL_STAMPS/$1" head installed=""
  if claude plugin list --json | jq -e --arg id "$old" '.[] | select(.id == $id)' >/dev/null; then
    claude plugin uninstall "$old" >/dev/null
    changed "skills: uninstalled plugin $old (now from npx skills)"
  fi
  head="$(git ls-remote "https://github.com/$src.git" HEAD | cut -f1)"
  [[ -n $head ]] || die "skills: can't read the head of $src"
  [[ ! -f $stamp ]] || installed="$(<"$stamp")"
  [[ $installed != "$head" ]] || return 0
  npx --yes skills@latest add "$src" --global --agent claude-code --skill '*' --yes </dev/null >/dev/null
  mkdir -p "$SKILL_STAMPS"
  printf '%s\n' "$head" >"$stamp"
  if [[ -z $installed ]]; then
    changed "skills: installed $src"
  else
    changed "skills: updated $src (${installed:0:7}..${head:0:7})"
  fi
}

# Installs one entry of the skills: list: a skills CLI source (SKILL_NPX) or
# a skill repo, <owner>/<repo> or a bare name under SKILLS_OWNER.
install_skill() {
  local skill="$1"
  if [[ -n ${SKILL_NPX[$skill]:-} ]]; then
    install_skill_npx "$skill"
  elif [[ $skill == */* ]]; then
    install_skill_repo "$skill"
  else
    install_skill_repo "$SKILLS_OWNER/$skill"
  fi
}

# After login: this box's own SSH key on GitHub for auth and signing, git
# signing, the base and client skills (mattpocock's through npx skills), the
# herdr plugins, then repos.
finish() {
  local config title skill
  config="$(stored_config)" || exit 1
  [[ $(box_role "$config") != runner ]] || die "a runner box has no finish: devbox login is its last step"
  title="$(jq -r .hostname <<<"$config")" # dev-<client> unless the client file sets one
  gh_logged_in || die "gh is not logged in: run devbox login first"
  gh_has_scopes || die "gh lacks the ${GH_SCOPES[*]} scopes: run devbox login again"
  claude auth status --json 2>/dev/null | jq -e .loggedIn >/dev/null || die "claude is not logged in: run devbox login first"

  if [[ -f $SSH_KEY ]]; then
    say "ssh key: ${SSH_KEY/#$USER_HOME/\~} exists"
  else
    install -d -m 700 "${SSH_KEY%/*}"
    ssh-keygen -q -t ed25519 -N '' -C "$title" -f "$SSH_KEY"
    say "ssh key: generated ${SSH_KEY/#$USER_HOME/\~}"
  fi
  register_key keys authentication "$title"
  register_key ssh_signing_keys signing "$title"
  git_identity "$config"
  agent_instructions "$config"
  ado_setup "$config" "$title"

  while IFS= read -r skill; do
    install_skill "$skill"
  done < <(jq -r '.skills[]' <<<"$config")
  say "skills: all installed"
  herdr_plugins
  say "herdr: plugins installed"

  sync_repos "$config"
  mkdir -p "${FINISHED%/*}"
  touch "$FINISHED"
  say "finished"
}

# Runs "$@" in a subshell with errexit on, so a failure ends only that
# command; its exit status goes in $STATUS. Never call it where a status is
# tested (if, ||, &&): bash ignores errexit there, subshell included.
STATUS=0
isolated() {
  set +e
  (
    set -e
    "$@"
  )
  STATUS=$?
  set -e
}

# Runs update step $1, the function and arguments after it, isolated. Says
# "<step>: up to date" when it reported no change, and adds failed steps to
# FAILED.
FAILED=()
run_step() {
  local name="$1" before
  shift
  before="$(wc -l <"$CHANGES")"
  isolated "$@"
  if ((STATUS)); then
    say "$name: failed"
    FAILED+=("$name")
  elif (($(wc -l <"$CHANGES") == before)); then
    say "$name: up to date"
  fi
}

# Every skill repo pulled and re-installed when its head moved; skills newly
# listed installed. One failing skill doesn't stop the others.
update_skills() {
  local config="$1" skill failed=0
  while IFS= read -r skill; do
    isolated install_skill "$skill" </dev/null
    ((STATUS == 0)) || { say "skills: $skill failed"; failed=1; }
  done < <(jq -r '.skills[]' <<<"$config")
  ((failed == 0))
}

# User-scope plugins, "<id> <version>" sorted by id.
plugin_versions() {
  claude plugin list --json | jq -r '.[] | select(.scope == "user") | "\(.id) \(.version // "?")"' | sort
}

# Refreshes the marketplaces, then `claude plugin update`s every plugin
# installed in user scope.
update_plugins() {
  local before id version old
  claude plugin marketplace update >/dev/null
  before="$(plugin_versions)"
  while read -r id _; do
    claude plugin update "$id" >/dev/null </dev/null
  done <<<"$before"
  while read -r id version; do
    old="$(awk -v id="$id" '$1 == id { print $2 }' <<<"$before")"
    [[ $old == "$version" ]] || changed "plugins: updated $id (${old:-none} -> $version)"
  done < <(plugin_versions)
}

# pacman -Syu: Arch upgrades the whole system together, base packages with it.
update_pacman() {
  local before upgraded=()
  before="$(pacman -Q | sort)"
  sudo pacman -Syu --noconfirm -q >/dev/null
  mapfile -t upgraded < <(comm -13 <(printf '%s\n' "$before") <(pacman -Q | sort) | cut -d' ' -f1)
  ((${#upgraded[@]} == 0)) || changed "pacman: upgraded ${#upgraded[@]} package(s): ${upgraded[*]}"
}

# mise tools asked for as "latest" (herdr and 1password in the system config,
# and any client tool@latest) upgraded; versions no config uses pruned.
update_mise() {
  local outdated name current latest tools=()
  outdated="$(mise outdated --json | jq -r 'to_entries[] | select(.value.requested == "latest")
    | "\(.key) \(.value.current // "none") \(.value.latest)"')"
  [[ -n $outdated ]] || return 0
  mapfile -t tools < <(cut -d' ' -f1 <<<"$outdated")
  MISE_YES=1 mise upgrade "${tools[@]}"
  MISE_YES=1 mise prune --yes
  while read -r name current latest; do
    changed "mise: upgraded $name ($current -> $latest)"
  done <<<"$outdated"
}

# The azure-devops extension updated, or added when missing (login adds it,
# but a box may have gained Azure DevOps repos since).
update_az() {
  local before after
  command -v az >/dev/null || { say "az: not installed (devbox sync installs it)"; return 1; }
  add_az_extension && return
  before="$(az extension show --name "$AZ_EXTENSION" --query version -o tsv)"
  # Exits 0 when it is already the latest.
  az extension update --name "$AZ_EXTENSION" --only-show-errors
  after="$(az extension show --name "$AZ_EXTENSION" --query version -o tsv)"
  [[ $before == "$after" ]] || changed "az: updated $AZ_EXTENSION ($before -> $after)"
}

update_claude() {
  local before after
  before="$(claude --version)"
  claude update >/dev/null
  after="$(claude --version)"
  [[ $before == "$after" ]] || changed "claude: updated ${before%% *} -> ${after%% *}"
}

# The lazy.nvim plugins, "<name> <commit>", one per line.
nvim_plugin_heads() {
  local dir
  for dir in "$USER_HOME"/.local/share/nvim/lazy/*/; do
    [[ -d $dir.git ]] || continue
    printf '%s %s\n' "$(basename "$dir")" "$(git -C "$dir" rev-parse --short HEAD)"
  done
}

# Puts the nvim plugins at the commits in the box's lazy-lock.json (the one
# copied from this repo, unless edited on the box).
update_nvim() {
  local before out moved=()
  before="$(nvim_plugin_heads)"
  # stdin from /dev/null: lazy.lua waits for a key when it can't clone lazy.nvim.
  # The timeout bounds a hang (seen once on a first install) to 15 minutes.
  if ! out="$(timeout 900 nvim --headless '+Lazy! restore' +qa </dev/null 2>&1)"; then
    printf '%s\n' "$out" >&2
    return 1
  fi
  mapfile -t moved < <(comm -13 <(printf '%s\n' "$before") <(nvim_plugin_heads) | cut -d' ' -f1)
  ((${#moved[@]} == 0)) || changed "nvim: ${#moved[@]} plugin(s) restored to lazy-lock.json: ${moved[*]}"
}

# After finish: brings current what finish and bootstrap installed. Each step
# reports what it changed (or that it is up to date); a failing step doesn't
# stop the others, and makes update exit 1 at the end. $2:
# --no-pacman-upgrade skips pacman -Syu.
update() {
  local config="$1" no_upgrade="$2"
  [[ -n $config ]] || config="$(stored_config)" || exit 1
  [[ $(box_role "$config") != runner ]] || die "a runner box has no update: devbox sync converges it"
  [[ -f $FINISHED ]] || die "devbox finish has not run on this box yet"
  # mise and nvim read config from the current directory too.
  cd "$USER_HOME"
  CHANGES="$(mktemp)"
  trap 'rm -f "$CHANGES"' EXIT

  run_step skills update_skills "$config"
  run_step plugins update_plugins
  run_step herdr herdr_plugins
  if [[ -n $no_upgrade ]]; then
    say "pacman: skipped (--no-pacman-upgrade)"
  else
    run_step pacman update_pacman
  fi
  run_step mise update_mise
  run_step claude update_claude
  [[ -z $(ado_orgs "$config") ]] || run_step az update_az
  run_step configs copy_configs
  run_step nvim update_nvim

  ((${#FAILED[@]} == 0)) || die "update: failed: ${FAILED[*]}"
  say "updated"
}

# Before the box is destroyed: deletes its SSH keys (auth and signing) from
# GitHub, matched by key or by the box's title (in case the key file is
# gone), and logs out of az and tailscale. Named so it doesn't shadow bash's
# logout.
box_logout() {
  local title key="" kind ids id state
  title="$(stored_config | jq -r .hostname)"
  [[ ! -f $SSH_KEY.pub ]] || key="$(cut -d' ' -f1,2 "$SSH_KEY.pub")"
  # First, so the reminder shows even when removing the GitHub keys fails.
  if [[ -f $ADO_KEY.pub ]]; then
    say "azure devops: remove this box's key by hand: Azure DevOps -> User settings -> SSH public keys,"
    say "azure devops: the key titled '$title', fingerprint $(ssh-keygen -lf "$ADO_KEY.pub" | cut -d' ' -f2)"
  fi
  if ! gh_logged_in; then
    [[ -z $key ]] || die "gh is not logged in; can't remove this box's keys from GitHub"
    say "github: gh not logged in and no SSH key; nothing to remove"
  else
    gh_has_scopes || die "gh lacks the ${GH_SCOPES[*]} scopes; can't remove this box's keys (devbox login adds them)"
    for kind in keys ssh_signing_keys; do
      # Listed first, so a failed listing stops here instead of deleting nothing.
      ids="$(gh api --paginate "user/$kind" |
        jq -r --arg k "$key" --arg t "$title" '.[] | select(.key == $k or .title == $t) | .id')"
      for id in $ids; do
        gh api -X DELETE "user/$kind/$id" --silent
        say "github: deleted ${kind//_/ } $id"
      done
    done
  fi
  # On a box destroy has just started, tailscaled may still be starting up.
  for _ in {1..15}; do
    state="$(tailscale status --json 2>/dev/null | jq -r .BackendState || true)"
    [[ $state == "" || $state == NoState || $state == Starting ]] || break
    sleep 1
  done
  if tailscale_up; then
    sudo tailscale logout
    say "tailscale: logged out"
  else
    say "tailscale: not logged in"
  fi
  # Last: local only, so a failure can't hold back the GitHub and tailscale
  # cleanup above.
  if command -v az >/dev/null && az account show &>/dev/null; then
    az logout
    say "az: logged out"
  else
    say "az: not logged in"
  fi
}

# Claude Remote Control on demand: splits the calling herdr pane and runs
# claude --remote-control in the new pane, in ~/work, so the session is
# reachable from the Claude app and still visible in herdr.
rc() {
  local name="${1:-}" pane run=(claude --remote-control)
  [[ ${HERDR_ENV:-} == 1 ]] || die "rc runs inside herdr (herdr, or herdr --remote <box> from your machine)"
  claude auth status --json 2>/dev/null | jq -e .loggedIn >/dev/null || die "claude is not logged in: run devbox login first"
  [[ -z $name ]] || run+=("$name")
  mkdir -p "$WORK"
  pane="$(herdr pane split --current --direction right --cwd "$WORK" | jq -er .result.pane.pane_id)" ||
    die "herdr pane split failed"
  # The pane's shell runs the line, so quote the name for it.
  herdr pane run "$pane" "${run[*]@Q}" >/dev/null || die "herdr pane run failed in pane $pane"
  say "Remote Control starting in herdr pane $pane (${WORK/#$USER_HOME/\~}); open it in the Claude app"
}

# Stows this repo's dotfiles/ packages (bash, git, gh) into the user's home.
# Real files in the way (the skeleton .bashrc) are moved aside.
dotfiles() {
  local repo="$ROOT/dotfiles" pkg rel target
  for pkg in "${DOTFILES_PACKAGES[@]}"; do
    while IFS= read -r rel; do
      target="$USER_HOME/$rel"
      if [[ -e $target && ! -L $target ]]; then
        mv "$target" "$target.bak"
        say "dotfiles: moved ${target/#$USER_HOME/\~} aside to $rel.bak"
      fi
    done < <(cd "$repo/$pkg" && find . -type f -printf '%P\n')
  done
  # A real directory, so stow links the file inside it rather than the whole
  # directory.
  as_user mkdir -p "$USER_HOME/.config/git"
  as_user stow -d "$repo" -t "$USER_HOME" -R "${DOTFILES_PACKAGES[@]}"

  # An older box has these stowed as links into the checkout; replace them.
  [[ ! -L $USER_HOME/.config/gh/config.yml ]] || rm "$USER_HOME/.config/gh/config.yml"
  [[ ! -L $USER_HOME/.config/nvim ]] || rm "$USER_HOME/.config/nvim"
  copy_configs
}

# The copied configs (gh's config.yml, the nvim config): adds the files in
# this repo that the box lacks, as the box user; files already there, edited
# or not, are kept.
copy_configs() {
  local pkg rel added
  for pkg in "$ROOT/${GH_CONFIG%/.config/*}" "$ROOT/${NVIM_CONFIG%/.config/*}"; do
    added=()
    while IFS= read -r rel; do
      [[ -e $USER_HOME/$rel ]] && continue
      as_user install -D -m 644 "$pkg/$rel" "$USER_HOME/$rel"
      added+=("$rel")
    done < <(cd "$pkg" && find . -type f -printf '%P\n' | sort)
    ((${#added[@]} == 0)) || changed "configs: added ${added[*]/#/\~/}"
  done
}

# Succeeds when an overlay mount works on /var/lib's filesystem, where Docker
# keeps its layers: ext4 (LVM-thin) does, ZFS before 2.2 doesn't.
overlay_works() {
  local dir rc=0
  dir="$(mktemp -d -p /var/lib devbox-overlay.XXXXXX)"
  mkdir "$dir"/{lower,upper,work,merged}
  mount -t overlay overlay -o "lowerdir=$dir/lower,upperdir=$dir/upper,workdir=$dir/work" "$dir/merged" 2>/dev/null || rc=1
  ((rc)) || umount "$dir/merged"
  rm -rf "$dir"
  return "$rc"
}

# Docker for daniel: overlay2 where the rootfs takes an overlay mount, else
# fuse-overlayfs, which needs /dev/fuse (the container's fuse=1 feature,
# which devbox-create doesn't set). Without either, Docker falls back to vfs.
docker_setup() {
  local driver=""
  if overlay_works; then
    driver=overlay2
  elif [[ -c /dev/fuse ]]; then
    driver=fuse-overlayfs
    pacman -S --needed --noconfirm -- fuse-overlayfs
  else
    say "docker: no overlay mount and no /dev/fuse, docker uses vfs (see the README)"
  fi
  local restart=false
  if [[ -n $driver ]]; then
    say "docker: storage driver $driver"
    write_if_changed "$DOCKER_DAEMON" "$(jq -n --arg d "$driver" '{"storage-driver": $d}')" 644 && restart=true
  elif [[ -f $DOCKER_DAEMON ]]; then
    # A driver an earlier run picked that no longer works keeps dockerd down.
    rm "$DOCKER_DAEMON"
    restart=true
  fi
  # A change only reaches a daemon already running once it restarts.
  if $restart && [[ -d /run/systemd/system ]]; then
    systemctl try-restart docker.service
  fi
  # Takes effect at daniel's next login.
  id -nG "$USER_NAME" | grep -qw docker || usermod -aG docker "$USER_NAME"
  if [[ -d /run/systemd/system ]]; then
    systemctl enable --now docker.service
  else
    say "docker: no systemd, docker not started"
  fi
}

bootstrap() {
  local config role
  say "base packages"
  # jq reads the config, whose role picks the base packages.
  command -v jq >/dev/null || pacman -Syu --needed --noconfirm -- jq
  config="$(stored_config)" || exit 1
  role="$(box_role "$config")"
  base_packages "$role"

  say "locale"
  # The template sets LANG=en_US.UTF-8 without generating it.
  if ! locale -a 2>/dev/null | grep -qix 'en_US.utf8'; then
    sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
    locale-gen >/dev/null
  fi

  say "user $USER_NAME"
  id "$USER_NAME" &>/dev/null || useradd -m -G wheel -s /bin/bash "$USER_NAME"
  if write_if_changed /etc/sudoers.d/devbox "$USER_NAME ALL=(ALL:ALL) NOPASSWD: ALL" 440; then
    visudo -cqf /etc/sudoers.d/devbox || { rm -f /etc/sudoers.d/devbox; die "invalid sudoers entry"; }
  fi
  ln -sfn "$ROOT/bin/devbox" /usr/local/bin/devbox
  # Login shells (ssh <box> claude) find the user's tools without .bashrc.
  # shellcheck disable=SC2016 # expanded at login, not here
  write_if_changed /etc/profile.d/devbox.sh \
    'PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"' 644 || true

  say "tailscale"
  # Containers boot systemd; skip when there is none (a plain chroot or image).
  if [[ -d /run/systemd/system ]]; then
    systemctl enable --now tailscaled
  else
    say "tailscale: no systemd, tailscaled not started"
  fi

  say "docker"
  docker_setup

  if [[ $role == runner ]]; then
    # op, ghrunner and the lockdown come with the sync; no Claude, mise
    # tools or dotfiles.
    sync
    return
  fi

  say "claude, herdr, 1Password CLI"
  [[ -x $USER_HOME/.local/bin/claude ]] || as_user bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
  write_if_changed /etc/mise/config.toml "$BASE_TOOLS" 644 || true # installed by the sync below

  say "dotfiles"
  dotfiles

  sync
}

main() {
  local args=("$@") cmd="${1:-}" config_json="" no_upgrade=""
  [[ -n $cmd ]] || { usage >&2; exit 1; }
  shift
  case "$cmd" in
    -h | --help) usage; exit 0 ;;
    bootstrap | login | finish | logout) (($# == 0)) || die "$cmd takes no arguments" ;;
    sync | update)
      while (($#)); do
        case "$1" in
          --config-json) (($# >= 2)) || die "--config-json needs a value"; config_json="$2"; shift ;;
          --no-pacman-upgrade) no_upgrade="$1" ;;
          *) usage >&2; die "unknown argument: $1" ;;
        esac
        shift
      done
      ;;
    rc) (($# <= 1)) || die "rc takes at most one argument, the session name" ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
  [[ -f $STATE/client ]] || die "no client recorded in $STATE/client: is this a devbox? (bootstrap.sh records it)"

  case "$cmd" in
    login | finish | update | logout)
      # The logins, keys and what finish installed belong to the box user.
      if ((EUID == 0)); then
        as_user "$0" "${args[@]}"
        exit
      fi
      [[ $(id -un) == "$USER_NAME" ]] || die "$cmd runs as $USER_NAME"
      case "$cmd" in
        login) login ;;
        finish) finish ;;
        update) update "$config_json" "$no_upgrade" ;;
        logout) box_logout ;;
      esac
      ;;
    rc)
      # Runs in the user's own herdr session, which root can't reach.
      [[ $(id -un) == "$USER_NAME" ]] || die "rc runs as $USER_NAME, inside herdr"
      rc "$@"
      ;;
    *)
      ((EUID == 0)) || exec sudo "$0" "${args[@]}"
      case "$cmd" in
        bootstrap) bootstrap ;;
        sync) sync "$config_json" "$no_upgrade" ;;
      esac
      ;;
  esac
}

main "$@"
