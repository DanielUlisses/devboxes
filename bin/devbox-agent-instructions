#!/usr/bin/env bash
# Print the global agent instructions for a devbox, generated from a client's
# resolved config (bin/devbox-config --json) read on stdin. `devbox finish`
# and `devbox sync` write them to ~/.claude/CLAUDE.md and ~/AGENTS.md in the
# box. Locally: bin/devbox-config --json <client> | bin/devbox-agent-instructions
set -euo pipefail

usage() {
  cat <<EOF
Usage: devbox-config --json <client> | devbox-agent-instructions

Print the agent instructions (Markdown) for the box of the resolved config
on stdin: headless box, git and PR rules, tools and resource limits.
EOF
}

die() {
  printf 'devbox-agent-instructions: %s\n' "$*" >&2
  exit 1
}

# The Markdown, from the resolved config. Azure DevOps repos are SSH URLs,
# git@ssh.dev.azure.com:v3/<org>/<project>/<repo>; the rest are GitHub
# <owner>/<repo>.
# shellcheck disable=SC2016 # jq expands these, not the shell
INSTRUCTIONS='
def ado: startswith("git@ssh.dev.azure.com:v3/");
def bullets: if length == 0 then ["- none"] else map("- \(.)") end;
([.repos[] | select(ado) | ltrimstr("git@ssh.dev.azure.com:v3/") | split("/")
  | "`\(.[0])` / `\(.[1])`"] | unique) as $ado
| ([.repos[] | select(ado | not) | split("/")[0] | "`\(.)`"] | unique) as $gh
| .resources as $r
| [
"<!-- Generated by devbox from this box\u0027s client config; devbox sync overwrites it.",
"     Your own additions go in ~/.claude/CLAUDE.local.md, which is kept. -->",
"# Devbox",
"",
"You are running in a headless dev VM (`\(.hostname)`), one per client, set up by devbox.",
"",
"## Headless box",
"",
"- No X display, no browser, no `xdg-open`. Never try to open a URL: print it for the developer.",
"  `$BROWSER` prints the URL it is given.",
"- Logins are device-code only (`gh auth login`, `az login --use-device-code`, ...).",
"- The clipboard is OSC 52 only: no `xclip`, `xsel` or `wl-copy`.",
"",
"## Git",
"",
"- Never commit. Leave changes unstaged: the developer reviews them in VS Code and commits.",
"- Push only to open a pull request the developer asked for, after they committed: `git push -u origin HEAD`.",
"  Never force-push, never push to the default branch, never rewrite commits.",
"- Work in a worktree under `~/work`, made with `herdr worktree create`, not in the main clone.",
"",
"## Pull requests",
"",
"Open one only when asked, from the developer\u0027s committed branch (push it first, as above), for the repo whose remote you are on:",
"",
"- GitHub (`github.com` remote): `gh pr create`.",
"- Azure DevOps (`dev.azure.com` remote): `az repos pr create --org https://dev.azure.com/<org> --project <project> --repository <repo>`,",
"  with org, project and repo read from the remote URL (`git@ssh.dev.azure.com:v3/<org>/<project>/<repo>`",
"  or `https://dev.azure.com/<org>/<project>/_git/<repo>`).",
"",
"This box\u0027s GitHub owners:",
"",
($gh | bullets[]),
"",
"This box\u0027s Azure DevOps orgs / projects:",
"",
($ado | bullets[]),
"",
"## Tools",
"",
"- pacman packages: \(if (.packages | length) == 0 then "base image only" else .packages | map("`\(.)`") | join(", ") end).",
"- mise tools: \(if (.tools | length) == 0 then "none beyond the base" else .tools | map("`\(.)`") | join(", ") end); also `herdr` and the 1Password CLI (`op`).",
"- Docker, with buildx and compose.",
"- Secrets only via `op read op://...`, used inline (`$(op read ...)`): never print them, echo them or write them to a file.",
"",
"## Limits",
"",
"- \($r.memory_mb / 1024 * 10 | round / 10) GB of memory, \($r.swap_mb) MB swap, \($r.cores) cores, \($r.disk) disk.",
(if $r.cores <= 4 or $r.memory_mb < 8192
 then "- A small box: build and test one thing at a time; cap parallel jobs (`make -j2`, one `docker build` at a time)."
 else "- Keep parallel builds within \($r.cores) jobs; avoid several heavy builds or containers at once." end),
"",
"## Developer\u0027s additions",
"",
"Read `~/.claude/CLAUDE.local.md` too, if it exists: the developer\u0027s own notes for this box.",
"@~/.claude/CLAUDE.local.md"
] | join("\n")
'

main() {
  case "${1:-}" in
    -h | --help) usage; exit 0 ;;
    "") ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
  local config
  config="$(cat)"
  jq -e '(.hostname | type == "string") and (.resources | type == "object")
    and ([.packages, .tools, .repos] | all(type == "array"))' <<<"$config" >/dev/null 2>&1 ||
    die "stdin is not a resolved config (want the output of devbox-config --json)"
  jq -r "$INSTRUCTIONS" <<<"$config"
}

main "$@"
