#!/usr/bin/env bash
# Print a client's resolved devbox config: defaults.yaml merged with the
# client's file, clients/<client>.yaml in the private devbox-clients checkout
# ($DEVBOX_CLIENTS). Exits non-zero, naming each bad field, when either file
# is invalid.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DEFAULTS="$ROOT/defaults.yaml"
# Client files live in the private devbox-clients checkout; only
# underscore-prefixed ones (the template) live in this public repo.
CLIENTS_CHECKOUT="${DEVBOX_CLIENTS:-$ROOT/../devbox-clients}"
CLIENTS="$CLIENTS_CHECKOUT/clients"
PUBLIC_CLIENTS="$ROOT/clients"
# shellcheck source-path=SCRIPTDIR/.. source=lib/host-name.sh
source "$ROOT/lib/host-name.sh"

usage() {
  cat <<EOF
Usage: devbox-config [--json] <client>

Print the resolved config for <client>, merged over defaults.yaml, as YAML
(or JSON with --json). Client files are clients/<client>.yaml in the
devbox-clients checkout at \$DEVBOX_CLIENTS (default ../devbox-clients next
to this repo); _template resolves from this repo.

Clients in $(display "$CLIENTS"):
EOF
  local f
  for f in "$CLIENTS"/[!_]*.yaml; do
    [[ ! -e $f ]] || printf '  %s\n' "$(basename "$f" .yaml)"
  done
}

die() {
  printf 'devbox-config: %s\n' "$*" >&2
  exit 1
}

# A path as messages show it: relative to this repo, or to the directory
# holding the clients checkout (devbox-clients/clients/<client>.yaml).
display() {
  local path parent
  path="$(readlink -m "$1")"
  parent="$(dirname "$(readlink -m "$CLIENTS_CHECKOUT")")"
  case "$path" in
    "$ROOT"/*) printf '%s' "${path#"$ROOT"/}" ;;
    *) printf '%s' "${path#"$parent"/}" ;;
  esac
}

require_tools() {
  command -v jq >/dev/null || die "jq is required (pacman -S jq)"
  command -v yq >/dev/null || die "yq is required (pacman -S go-yq)"
  # Arch's `yq` package is a different tool (a Python jq wrapper).
  yq --version 2>&1 | grep -q mikefarah ||
    die "yq must be mikefarah/yq v4 (pacman -S go-yq), found: $(yq --version 2>&1)"
}

# YAML file -> JSON on stdout. An empty file reads as null.
to_json() {
  local out
  out="$(yq -o=json '.' "$1" 2>&1)" || die "$(display "$1"): invalid YAML: $out"
  [[ $(yq 'di' "$1" | wc -l) -le 1 ]] ||
    die "$(display "$1"): must hold a single YAML document (found a '---' separator)"
  printf '%s\n' "${out:-null}"
}

# Reads one config document as JSON, prints one "<field>: <problem>" line per
# error. $required: whether fields with no default must be present.
# shellcheck disable=SC2016 # jq program, not shell expansions
VALIDATE='
"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}" as $email_re
| "git@ssh\\.dev\\.azure\\.com:v3/[A-Za-z0-9-]+/[A-Za-z0-9._%-]+/[A-Za-z0-9._%-]+" as $ado_re
|
def path_str: reduce .[] as $k (""; if ($k|type) == "number" then "\(.)[\($k)]" elif . == "" then $k else "\(.).\($k)" end);
def err($p; $msg): "\($p): \($msg)";
def got: "(got \(tojson))";

def is_int: type == "number" and . == floor;
def int_min($p; $min):
  if . == null or (is_int and . >= $min) then empty
  else err($p; "must be an integer >= \($min) \(got)") end;

def str_match($p; $re; $what):
  if . == null then empty
  elif type != "string" or test("\n") or (test($re) | not) then err($p; "must be \($what) \(got)")
  else empty end;

def str_list($p; $re; $what):
  if . == null then empty
  elif type != "array" then err($p; "must be a list \(got)")
  else to_entries[] | .key as $i | .value | str_match("\($p)[\($i)]"; $re; $what) end;

def unknown_keys($prefix; $allowed):
  keys[] | select(IN($allowed[]) | not) | err($prefix + .; "unknown field");

if . == null then {} else . end
| if type != "object" then err("(top level)"; "must be a mapping of fields \(got)")
  else
    unknown_keys(""; ["hostname", "host", "claude_account", "git_name", "git_email", "resources", "packages", "tools", "skills", "repos",
                     "timezone", "backup", "backup_schedule", "backup_keep"]),

    (.hostname | str_match("hostname"; "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$";
      "a lowercase hostname (letters, digits, inner dashes, max 63)")),

    (.host | if . == "" then empty
      else str_match("host"; $host_re;
        "the ssh name of a Proxmox host (letters, digits, . _ -), or empty for $DEVBOX_HOST") end),

    (if $required and .claude_account == null then err("claude_account"; "required")
     else .claude_account | str_match("claude_account"; "^[A-Za-z0-9._-]+$";
       "an account label (letters, digits, . _ -), not an email") end),

    (.git_name | str_match("git_name"; "^[^<>\\n]*$"; "a name for commits (no < > or newlines)")),
    (.git_email | if . == "" then empty
      else str_match("git_email"; "^\($email_re)$"; "an email address, or empty for the GitHub noreply one") end),

    (.resources |
      if . == null then empty
      elif type != "object" then err("resources"; "must be a mapping \(got)")
      else
        unknown_keys("resources."; ["memory_mb", "swap_mb", "cores", "disk", "onboot"]),
        (.memory_mb | int_min("resources.memory_mb"; 1)),
        (.swap_mb | int_min("resources.swap_mb"; 0)),
        (.cores | int_min("resources.cores"; 1)),
        (.disk | str_match("resources.disk"; "^[1-9][0-9]*[MGT]$"; "a size like 40G")),
        (.onboot | if . == null or type == "boolean" then empty
                   else err("resources.onboot"; "must be true or false \(got)") end)
      end),

    (.timezone | str_match("timezone"; "^(UTC|[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9][A-Za-z0-9_+-]*)+)$";
      "an IANA zone like America/Sao_Paulo or UTC")),

    (.packages | str_list("packages"; "^[a-z0-9@._+-]+$"; "a pacman package name")),
    (.tools | str_list("tools"; "^[^@[:space:]]+@[^@[:space:]]+$"; "<tool>@<version>")),
    (.skills | str_list("skills"; "^([A-Za-z0-9-]+/)?[A-Za-z0-9._-]+$"; "a skill repo, <owner>/<repo> or <repo>")),
    (.repos | str_list("repos"; "^([A-Za-z0-9-]+/[A-Za-z0-9._-]+|\($ado_re))$";
      "a GitHub <owner>/<repo> or an Azure DevOps git@ssh.dev.azure.com:v3/<org>/<project>/<repo>")),

    (.backup | if . == null or type == "boolean" then empty
               else err("backup"; "must be true or false \(got)") end),
    (.backup_schedule | str_match("backup_schedule"; "^[A-Za-z0-9][A-Za-z0-9 :.,*/~+-]*$";
      "a Proxmox calendar event like 02:00 or \"mon..fri 21:00\"")),
    (.backup_keep | int_min("backup_keep"; 1)),

    # git_email is the one email; an Azure DevOps SSH URL only looks like one.
    (paths(type == "string") as $p | getpath($p)
      | select($p != ["git_email"] and ($p[0] != "repos" or (test("^\($ado_re)$") | not)))
      | select(test($email_re))
      | err($p | path_str; "looks like an email address; config files hold none"))
  end
'

# Defaults first, client second: mappings merge, lists replace, skills append.
# shellcheck disable=SC2016 # jq program, not shell expansions
MERGE='
def strip_nulls: if type == "object" then with_entries(select(.value != null) | .value |= strip_nulls) else . end;
($defaults | strip_nulls) as $d | ($client // {} | strip_nulls) as $c
| ($d * $c)
| .hostname //= "dev-\($name)"
| .skills = (reduce (($d.skills // []) + ($c.skills // []))[] as $s ([]; if IN(.[]; $s) then . else . + [$s] end))
| {hostname, host, claude_account, git_name, git_email, resources, packages, tools, skills, repos, timezone, backup, backup_schedule, backup_keep}
'

# Prints the errors of one file, prefixed with its displayed path.
validate() {
  local file="$1" json="$2" required="$3" prefix
  prefix="$(display "$file")"
  jq -r --argjson required "$required" --arg host_re "$DEVBOX_HOST_RE" "$VALIDATE" <<<"$json" |
    sed "s|^|$prefix: |"
}

main() {
  local format=yaml client=""
  while (($#)); do
    case "$1" in
      --json) format=json ;;
      -h | --help) usage; exit 0 ;;
      -*) usage >&2; die "unknown option: $1" ;;
      *) [[ -z $client ]] || die "expected one client, got '$client' and '$1'"; client="$1" ;;
    esac
    shift
  done
  [[ -n $client ]] || { usage >&2; exit 1; }

  # Underscore-prefixed files (the template) are not clients; their hostname
  # derives from the name without the underscore.
  local name="${client#_}"
  [[ $name =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ && ${#name} -le 59 ]] ||
    die "client name '$client' must be lowercase letters, digits and inner dashes, max 59 chars"

  local file
  if [[ $client == _* ]]; then
    file="$PUBLIC_CLIENTS/$client.yaml"
  else
    # This repo is public: a client's file here would publish its name.
    [[ ! -e $PUBLIC_CLIENTS/$client.yaml ]] ||
      die "clients/$client.yaml is in the public devboxes repo; move it to the devbox-clients repo"
    file="$CLIENTS/$client.yaml"
  fi
  [[ -f $file ]] || {
    usage >&2
    die "no such client: $client (looked for $(display "$file"); set DEVBOX_CLIENTS to the devbox-clients checkout)"
  }

  require_tools

  local defaults_json client_json errors
  defaults_json="$(to_json "$DEFAULTS")"
  client_json="$(to_json "$file")"
  errors="$(validate "$DEFAULTS" "$defaults_json" false; validate "$file" "$client_json" true)"
  if [[ -n $errors ]]; then
    printf '%s\n' "$errors" >&2
    die "invalid config for client '$client'"
  fi

  local merged
  merged="$(jq -n --argjson defaults "$defaults_json" --argjson client "$client_json" \
    --arg name "$name" "$MERGE")"
  if [[ $format == json ]]; then
    printf '%s\n' "$merged"
  else
    yq -p=json -o=yaml -P '.' <<<"$merged"
  fi
}

main "$@"
