#!/usr/bin/env bash
# Create and start a client's devbox: an unprivileged Arch container on the
# Proxmox host, sized from the client's resolved config, then bootstrapped
# from bootstrap.sh at the pushed commit of the repo's branch, with that
# resolved config handed in (the box can't read the private clients repo).
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR/.. source=lib/pve.sh
source "$ROOT/lib/pve.sh"

ROOTFS_STORAGE="${DEVBOX_STORAGE:-local-lvm}"
TEMPLATE_STORAGE="${DEVBOX_TEMPLATE_STORAGE:-local}"
BRIDGE="${DEVBOX_BRIDGE:-vmbr0}"
MIN_FREE_MB=1024
REPO=DanielUlisses/devboxes
BRANCH="${DEVBOX_BRANCH:-main}"

# Runs inside the new container: fetches bootstrap.sh ($1), retrying while its
# network comes up, and runs it with the remaining arguments.
# shellcheck disable=SC2016 # expanded in the container, not here
FETCH_BOOTSTRAP='for _ in {1..30}; do
  curl -fsSL "$1" -o /root/bootstrap.sh && exec bash /root/bootstrap.sh "${@:2}"
  sleep 2
done
echo "could not fetch $1" >&2
exit 1'

usage() {
  cat <<EOF
Usage: devbox-create [--light] [--dry-run] [--allow-unpushed] <client>

Create and start the devbox container for <client> (its file in the
devbox-clients checkout, see devbox-config) on the client's \`host\`, or
\$DEVBOX_HOST when it names none (one of the two is required),
using the first free VMID in $VMID_MIN-$VMID_MAX, sized from its resolved
\`resources\` (a role: runner box gets defaults.yaml's runner_resources: a low
CPU weight and hard memory, core and disk caps), then bootstrap it from
bootstrap.sh at the pushed head of $REPO's \$DEVBOX_BRANCH (default
main), handing it the client's resolved config from this machine. With
\`backup: true\`, adds the box's Proxmox backup job (to
\$DEVBOX_BACKUP_STORAGE, default local); refused, the box still created, on
a host running guests that aren't devboxes. Then adds the box to this
machine: ssh config entries and, for a devbox (not a runner), herdr
machine (bin/devbox-host add).
Refuses when this checkout's HEAD is not that pushed commit.

  --light           cap it at 1 GB memory, 512 MB swap, 1 core and an 8 GB disk
  --dry-run         run every check, then print the pct and pvesh commands
                    (memory, swap, cores, cpuunits, disk) instead
  --allow-unpushed  create even though this checkout's HEAD differs from
                    the pushed commit the box bootstraps from
EOF
}

# "40G" -> 40, in whole GB as pct's rootfs size wants; M rounds up.
disk_gb() {
  local n="${1%?}"
  case "$1" in
    *M) echo $(((n + 1023) / 1024)) ;;
    *G) echo "$n" ;;
    *T) echo $((n * 1024)) ;;
  esac
}

main() {
  local light=false dry_run=false allow_unpushed=false client=""
  while (($#)); do
    case "$1" in
      --light) light=true ;;
      --dry-run) dry_run=true ;;
      --allow-unpushed) allow_unpushed=true ;;
      -h | --help) usage; exit 0 ;;
      -*) usage >&2; die "unknown option: $1" ;;
      *) [[ -z $client ]] || die "expected one client, got '$client' and '$1'"; client="$1" ;;
    esac
    shift
  done
  [[ -n $client ]] || { usage >&2; exit 1; }

  local config hostname role memory swap cores disk cpuunits onboot
  config="$("$ROOT/bin/devbox-config" --json "$client")" || exit 1
  hostname="$(jq -r .hostname <<<"$config")"
  role="$(jq -r .role <<<"$config")"
  memory="$(jq -r .resources.memory_mb <<<"$config")"
  swap="$(jq -r .resources.swap_mb <<<"$config")"
  cores="$(jq -r .resources.cores <<<"$config")"
  disk="$(disk_gb "$(jq -r .resources.disk <<<"$config")")"
  cpuunits="$(jq -r .resources.cpuunits <<<"$config")"
  onboot="$(jq -r 'if .resources.onboot then 1 else 0 end' <<<"$config")"
  use_config_host "$config"
  if $light; then
    ((memory <= 1024)) || memory=1024
    ((swap <= 512)) || swap=512
    cores=1
    ((disk <= 8)) || disk=8
  fi

  # The box clones the public repo, so it can only follow what's pushed.
  local commit
  commit="$(git ls-remote "https://github.com/$REPO.git" "refs/heads/$BRANCH" | cut -f1)"
  [[ $commit =~ ^[0-9a-f]{40}$ ]] || die "could not find branch $BRANCH on github.com/$REPO: is it pushed?"
  # The box runs the pushed scripts and this machine the local ones (devbox-config
  # here, bootstrap.sh there), so the two must be the same commit.
  local head
  head="$(git -C "$ROOT" rev-parse HEAD)"
  if [[ $head != "$commit" ]]; then
    $allow_unpushed ||
      die "refusing: this checkout is at ${head:0:12}, but the box would bootstrap from $BRANCH at ${commit:0:12} on github.com/$REPO; push it (or set DEVBOX_BRANCH), or pass --allow-unpushed"
    say "warning: this checkout is at ${head:0:12}, the box bootstraps from $BRANCH at ${commit:0:12} (--allow-unpushed)"
  fi

  local free_kb
  free_kb="$(pve cat /proc/meminfo | awk '/^MemAvailable:/ {print $2}')"
  [[ $free_kb =~ ^[0-9]+$ ]] || die "could not read free memory on $DEVBOX_HOST"
  ((free_kb / 1024 >= MIN_FREE_MB)) ||
    die "refusing: $DEVBOX_HOST has $((free_kb / 1024)) MB available, needs at least $MIN_FREE_MB MB"

  local all existing vmid
  all="$(guests)"
  existing="$(jq -r --arg h "$hostname" '[.[] | select(.name == $h) | "\(.type)/\(.vmid)"] | join(" ")' <<<"$all")"
  [[ -z $existing ]] || die "$hostname already exists on $DEVBOX_HOST as $existing"
  vmid="$(jq -r --argjson lo "$VMID_MIN" --argjson hi "$VMID_MAX" \
    '[.[].vmid] as $used | first(range($lo; $hi + 1) | select(IN($used[]) | not)) // empty' <<<"$all")"
  [[ -n $vmid ]] || die "no free VMID in $VMID_MIN-$VMID_MAX on $DEVBOX_HOST"

  # Downloading a template is a host-level change, so it's left to a person.
  local template
  template="$(pve pveam list "$TEMPLATE_STORAGE" | awk '$1 ~ /\/archlinux-base_/ {print $1}' | sort -V | tail -n1)"
  [[ -n $template ]] || die "no Arch template in $TEMPLATE_STORAGE on $DEVBOX_HOST; on the host, run:
  pveam update && pveam available --section system | grep archlinux
  pveam download $TEMPLATE_STORAGE <archlinux-base_...tar.zst>"

  local create=(pct create "$vmid" "$template"
    --hostname "$hostname"
    --tags "$DEVBOX_TAG"
    --unprivileged 1
    --features "nesting=1,keyctl=1"
    --dev0 /dev/net/tun
    --memory "$memory" --swap "$swap" --cores "$cores" --cpuunits "$cpuunits"
    --rootfs "$ROOTFS_STORAGE:$disk"
    --net0 "name=eth0,bridge=$BRIDGE,ip=dhcp"
    --onboot "$onboot")
  local bootstrap=(pct exec "$vmid" -- bash -c "$FETCH_BOOTSTRAP" bootstrap
    "https://raw.githubusercontent.com/$REPO/$commit/bootstrap.sh"
    "$client" "https://github.com/$REPO.git" "$BRANCH" "$commit" "$(jq -c . <<<"$config")")

  if $dry_run; then
    printf '%q ' "${create[@]}"
    printf '\n'
    printf '%q ' "${bootstrap[@]}"
    printf '\n'
    sync_backup_job "$hostname" "$vmid" "$config" true
    "$ROOT/bin/devbox-host" --dry-run add --new-box "$client" || true
    exit 0
  fi

  say "creating $role $hostname as VMID $vmid on $DEVBOX_HOST ($memory MB + $swap MB swap, $cores cores, CPU weight $cpuunits, ${disk}G)"
  pve "${create[@]}"
  assert_devbox "$vmid" "$hostname"
  pve pct start "$vmid"
  say "started $hostname (VMID $vmid); bootstrapping from $REPO@${commit:0:12}"
  pve "${bootstrap[@]}" ||
    die "bootstrap failed in $hostname (VMID $vmid); fix it, then bin/devbox-destroy $client and create again"
  say "bootstrapped $hostname"
  sync_backup_job "$hostname" "$vmid" "$config" ||
    say "created $hostname without a backup job; bin/devbox-sync $client adds it once the host allows it"
  # This machine's side: ssh config entries, no stale host keys, the herdr
  # machine (none for a runner).
  "$ROOT/bin/devbox-host" add --new-box "$client" ||
    say "$hostname is up, but this machine's side is unfinished; once it is on the tailnet: bin/devbox-host add $client"
}

main "$@"
