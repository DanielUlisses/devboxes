#!/usr/bin/env bash
# Run this repo's checks: each section runs its cases, one line per case,
# then a summary. Exits non-zero when any case fails.
#
# Sections:
#   config  bin/devbox-config rejects each broken client in tests/config/,
#           naming the field, and resolves the ones marked ok.
#   schema  every key of defaults.yaml (plus hostname) is documented in
#           clients/_template.yaml, accepted by the validator and present in
#           the resolved output.
#   run     bin/devbox-run drives tests/run/fake-claude in tmux: start, log,
#           say, a lost session resumed with --resume, exit codes, dialogs.
#           Skipped (one line) without tmux.
#
# A section is a check_<name> function listed in SECTIONS; it reports each
# case with pass or fail.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

SECTIONS=(config schema run)

passed=0
failed=0
pass() {
  printf 'ok    %s\n' "$1"
  passed=$((passed + 1))
}
# fail <case> <reason> [<output>]: the output, if any, is printed indented.
fail() {
  printf 'FAIL  %s: %s\n' "$1" "$2"
  local line
  [[ -z ${3:-} ]] || while IFS= read -r line; do printf '      | %s\n' "$line"; done <<<"$3"
  failed=$((failed + 1))
}

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

# --- config ---------------------------------------------------------------
# Each case is tests/config/<case>.yaml, a client file whose first line is
# `# expect: <substring>`: devbox-config must exit non-zero with the
# substring on stderr, or, for `# expect: ok`, exit 0.

# config_case <case> <expect> <client file>: runs devbox-config on the file
# as client <case>, from a clients checkout of its own.
config_case() {
  local name="$1" expect="$2" file="$3" clients="$scratch/config" err status=0
  rm -rf "$clients"
  mkdir -p "$clients/clients"
  cp "$file" "$clients/clients/$name.yaml"
  err="$(DEVBOX_CLIENTS="$clients" "$ROOT/bin/devbox-config" "$name" 2>&1 >/dev/null)" || status=$?
  if [[ $expect == ok ]]; then
    if ((status == 0)); then pass "config/$name"
    else fail "config/$name" "expected it to resolve, devbox-config exited $status" "$err"; fi
  elif ((status == 0)); then
    fail "config/$name" "expected an error containing '$expect', but it resolved"
  elif [[ $err != *"$expect"* ]]; then
    fail "config/$name" "expected an error containing '$expect'" "$err"
  else
    pass "config/$name"
  fi
}

check_config() {
  local f name first
  for f in "$ROOT"/tests/config/*.yaml; do
    [[ -e $f ]] || continue
    name="$(basename "$f" .yaml)"
    IFS= read -r first <"$f" || first=""
    if [[ $first != "# expect: "?* ]]; then
      fail "config/$name" "first line must be '# expect: <substring>' or '# expect: ok'"
      continue
    fi
    config_case "$name" "${first#"# expect: "}" "$f"
  done

  # The email scan's case is built here: the pre-commit hook refuses a
  # staged file holding an email address, so no case file can hold one.
  local at="@"
  printf 'claude_account: work\ngit_name: "someone%sexample.com"\n' "$at" >"$scratch/email-scan.yaml"
  config_case email-scan 'git_name: looks like an email address; config files hold none' \
    "$scratch/email-scan.yaml"
}

# --- schema ---------------------------------------------------------------
# CLAUDE.md: a schema change touches _template.yaml, defaults.yaml and the
# validator together. For each key K of defaults.yaml plus hostname:
#   1. _template.yaml has `key:` or `# key:` at the start of a line;
#   2. the validator accepts it: a client setting the key to its default
#      value resolves (hostname is derived, so it has no default to set);
#   3. `devbox-config --json _template` outputs it.
# Four keys are special, by design:
#   runner_resources  defaults.yaml only: a client file may not set it (2), and
#                     the merge folds it into a runner's `resources` (3), so
#                     (3) compares that to the runner's output.
#   hub_resources     the same, for a hub client.
#   runners           runner role only: (2) uses a runner client, and (3) looks
#                     for it in a runner client's output, not the template's.
#   claude_account    in the output but not in defaults.yaml (it has no
#                     default; a devbox must set it), so it is the one output
#                     key allowed outside K.
# If defaults.yaml makes the validator reject the template, 2 and 3 cannot run:
# the errors naming a key are reported as that key's assertion 2, the rest as
# schema/_template, and only 1 still runs for every key.

schema_clients="$scratch/schema"
schema_err="$scratch/schema.err"

# schema_resolve <client file>: resolves it as client `schema`; prints the
# JSON, and leaves devbox-config's stderr in $schema_err.
schema_resolve() {
  rm -rf "$schema_clients"
  mkdir -p "$schema_clients/clients"
  cp "$1" "$schema_clients/clients/schema.yaml"
  DEVBOX_CLIENTS="$schema_clients" "$ROOT/bin/devbox-config" --json schema 2>"$schema_err"
}

check_schema() {
  local keys=() k bad=0 before=$failed ykeys
  ykeys="$(yq -r '. | keys | .[]' "$ROOT/defaults.yaml")" ||
    { fail "schema/defaults" "yq could not read the keys of defaults.yaml"; return; }
  [[ -n $ykeys ]] || { fail "schema/defaults" "defaults.yaml has no keys"; return; }
  mapfile -t keys <<<"$ykeys"
  keys+=(hostname)

  # Resolved output of a devbox (the template), a runner and a hub. If any
  # fails, 2 and 3 are skipped; errors naming a key are kept for that key.
  local resolved=1 tmpl_json runner_json hub_json tmpl_keys runner_keys hub_keys err="" line lk
  local -A key_errs=()
  local generic=()
  tmpl_json="$("$ROOT/bin/devbox-config" --json _template 2>"$schema_err")" || resolved=0
  err="$(<"$schema_err")"
  if ((resolved)); then
    printf 'role: runner\nrunners:\n  org: example-org\n  labels: [homelab]\n' >"$scratch/runner.yaml"
    if runner_json="$(schema_resolve "$scratch/runner.yaml")"; then
      tmpl_keys="$(jq -r 'keys[]' <<<"$tmpl_json")"
      runner_keys="$(jq -r 'keys[]' <<<"$runner_json")"
    else
      resolved=0
      fail "schema/runner" "a minimal runner client did not resolve" "$(<"$schema_err")"
    fi
    printf 'role: hub\n' >"$scratch/hub.yaml"
    if hub_json="$(schema_resolve "$scratch/hub.yaml")"; then
      hub_keys="$(jq -r 'keys[]' <<<"$hub_json")"
    else
      resolved=0
      fail "schema/hub" "a minimal hub client did not resolve" "$(<"$schema_err")"
    fi
  else
    while IFS= read -r line; do
      # the trailer devbox-config adds to any validation error names no key
      [[ -n $line && $line != 'devbox-config: invalid config for client'* ]] || continue
      lk="$(sed -nE 's/^defaults\.yaml: ([a-z_]+)[:.].*/\1/p' <<<"$line")"
      if [[ -n $lk ]] && printf '%s\n' "${keys[@]}" | grep -qx "$lk"; then
        key_errs[$lk]+="${key_errs[$lk]:+ }$line"
      else
        generic+=("$line")
      fi
    done <<<"$err"
    # a non-zero exit with no (usable) stderr must still fail
    ((${#generic[@]} || ${#key_errs[@]})) ||
      generic+=("devbox-config exited non-zero with no error output")
    if ((${#generic[@]})); then
      fail "schema/_template" "devbox-config --json _template failed with errors naming no defaults.yaml key" "$(printf '%s\n' "${generic[@]}")"
    fi
  fi

  local problems file p
  for k in "${keys[@]}"; do
    problems=()

    # 1. documented in the template
    grep -Eq "^(# )?$k:" "$ROOT/clients/_template.yaml" ||
      problems+=("1 (template): not in clients/_template.yaml as '$k:' or '# $k:'")

    # 2. accepted by the validator
    if [[ -n ${key_errs[$k]:-} ]]; then
      problems+=("2 (validator): ${key_errs[$k]}")
    elif ((resolved)) && [[ $k != hostname && $k != runner_resources && $k != hub_resources ]]; then
      file="$scratch/key.yaml"
      if [[ $k == runners ]]; then
        yq '{"role": "runner", "runners": .["runners"]} | .runners.org = "example-org" | .runners.labels = ["homelab"]' \
          "$ROOT/defaults.yaml" >"$file"
      else
        { echo 'claude_account: example'; yq "{\"$k\": .[\"$k\"]}" "$ROOT/defaults.yaml"; } >"$file"
      fi
      if ! schema_resolve "$file" >/dev/null; then
        problems+=("2 (validator): a client setting '$k' to its default does not resolve: $(tr '\n' ' ' <"$schema_err")")
      fi
    fi

    # 3. in the resolved output
    if ((resolved)); then
      case $k in
        runner_resources)
          jq -e --argjson want "$(yq -o=json '.["runner_resources"]' "$ROOT/defaults.yaml")" \
            '.resources == $want' <<<"$runner_json" >/dev/null ||
            problems+=("3 (resolved output): a runner client's resources differ from defaults.yaml runner_resources") ;;
        hub_resources)
          jq -e --argjson want "$(yq -o=json '.["hub_resources"]' "$ROOT/defaults.yaml")" \
            '.resources == $want' <<<"$hub_json" >/dev/null ||
            problems+=("3 (resolved output): a hub client's resources differ from defaults.yaml hub_resources") ;;
        runners) grep -qx "$k" <<<"$runner_keys" ||
          problems+=("3 (resolved output): '$k' missing from a runner client's output") ;;
        tk_hub | metrics) ;; # optional: absent from the output unless a devbox sets it
        *) grep -qx "$k" <<<"$tmpl_keys" ||
          problems+=("3 (resolved output): '$k' missing from devbox-config --json _template") ;;
      esac
    fi

    if ((${#problems[@]})); then
      for p in "${problems[@]}"; do fail "schema/$k" "assertion $p"; done
      bad=$((bad + 1))
    elif ((resolved)); then
      pass "schema/$k"
    fi
  done

  # 3, the other way: neither output holds a key outside K.
  local extra
  if ((resolved)); then
    while IFS= read -r extra; do
      [[ $extra == claude_account ]] || printf '%s\n' "${keys[@]}" | grep -qx "$extra" ||
        { fail "schema/$extra" "assertion 3 (resolved output): '$extra' is output but is not a defaults.yaml key or hostname"; bad=$((bad + 1)); }
    done < <(printf '%s\n%s\n%s\n' "$tmpl_keys" "$runner_keys" "$hub_keys" | sort -u)
  fi

  printf 'schema: %d keys checked, %d failed (%d assertion failures)%s\n' \
    "${#keys[@]}" "$bad" "$((failed - before))" \
    "$( ((resolved)) || echo ' (assertions 2 and 3 skipped: devbox-config did not resolve)')"
}

# --- run ------------------------------------------------------------------
# One tmux server on its own socket and a state dir in $scratch; the fake
# claude stands in for the real one, so nothing logs in or spends tokens.
check_run() {
  if ! command -v tmux >/dev/null; then
    printf 'run: skipped (no tmux)\n'
    return
  fi
  local dir="$scratch/run" r="$ROOT/bin/devbox-run" fake="$ROOT/tests/run/fake-claude" out code
  mkdir -p "$dir"
  # The pre-commit hook runs this with git's GIT_DIR and GIT_INDEX_FILE set,
  # which would point every git below at this repo.
  unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
  export DEVBOX_RUN_STATE="$dir/state" DEVBOX_RUN_SOCKET="devbox-check-$$" CLAUDE_CONFIG_DIR="$dir/claude"
  # shellcheck disable=SC2064 # the socket is fixed now
  trap "tmux -L devbox-check-$$ kill-server 2>/dev/null; rm -rf '$scratch'" EXIT
  git init -q -b main "$dir/origin"
  git -C "$dir/origin" -c user.name=t -c user.email=nobody commit -q --allow-empty -m init
  git clone -q "$dir/origin" "$dir/repo"
  # wait_for <name> <text>: up to 5 s for the pane to show the text.
  wait_for() {
    local i
    for ((i = 0; i < 50; i++)); do
      "$r" log "$1" 2>/dev/null | grep -qF -- "$2" && return 0
      sleep 0.1
    done
    return 1
  }
  # expect_code <want> <got> <case>
  expect_code() {
    if (($1 == $2)); then pass "$3"; else fail "$3" "exit $2"; fi
  }
  # expect_status <name> <jq on its status object> <want> <case>
  expect_status() {
    local got
    got="$("$r" status "$1" | jq -r ".sessions[0] | $2")"
    if [[ $got == "$3" ]]; then pass "$4"; else fail "$4" "got $got" "$("$r" status "$1")"; fi
  }

  if out="$(CLAUDECODE=1 "$r" start w1 --repo "$dir/repo" --env FOO=bar --prompt "the brief" -- "$fake" --model x 2>&1)" &&
    [[ $(jq -r '.state + " " + .git.branch' <<<"$out") == "running w1" ]] && wait_for w1 "got: the brief"; then
    pass "run/start makes the worktree and sends the prompt"
  else
    fail "run/start makes the worktree and sends the prompt" "no 'got: the brief'" "$out$("$r" log w1 2>&1)"
  fi
  if "$r" log w1 | grep -q 'FOO=bar CLAUDECODE=unset'; then
    pass "run/start passes --env, drops CLAUDECODE"
  else
    fail "run/start passes --env, drops CLAUDECODE" "pane shows" "$("$r" log w1 2>&1)"
  fi

  expect_status w1 '[.model.id, .model.name, .rate_limits.seven_day.used_percentage] | join(" ")' "claude-fake-1 Fake 1 72" "run/status reports the model and rate limits the status line recorded"

  printf 'line one\nline two' | "$r" say w1 - 2>&1
  local i turn=""
  for ((i = 0; i < 30; i++)); do
    turn="$("$r" status w1 | jq -r '.sessions[0].last_turn')"
    [[ $turn == assistant_done ]] && "$r" log w1 | grep -q "got: line one" && break
    sleep 0.1
  done
  if wait_for w1 "line two" && [[ $turn == assistant_done ]]; then
    pass "run/say pastes a multi-line message as one"
  else
    fail "run/say pastes a multi-line message as one" "pane shows" "$("$r" log w1 2>&1)"
  fi

  "$r" say w1 hello 2>/dev/null && code=0 || code=$?
  expect_code 0 "$code" "run/say reports a message the transcript took (0)"

  mkdir -p "$dir/hooked"
  "$r" start w5 --dir "$dir/hooked" --env FAKE_HOOK=drop -- "$fake" >/dev/null
  wait_for w5 "fake claude" || true
  "$r" say w5 cold one 2>/dev/null && code=0 || code=$?
  expect_code 6 "$code" "run/say reports a message a hook dropped (6)"
  "$r" stop w5 >/dev/null 2>&1 || true
  mkdir -p "$dir/asked"
  "$r" start w6 --dir "$dir/asked" --env FAKE_HOOK=ask -- "$fake" >/dev/null
  wait_for w6 "fake claude" || true
  "$r" say w6 cold two 2>/dev/null && code=0 || code=$?
  expect_code 5 "$code" "run/say reports a message left at a hook's dialog (5)"
  "$r" say w6 more 2>/dev/null && code=0 || code=$?
  expect_code 5 "$code" "run/say refuses to type into a hook's dialog (5)"
  "$r" stop w6 >/dev/null 2>&1 || true

  "$r" start w1 --dir "$dir" -- "$fake" >/dev/null 2>&1 && code=0 || code=$?
  expect_code 4 "$code" "run/start refuses a running name (4)"

  tmux -L "$DEVBOX_RUN_SOCKET" kill-session -t =w1
  expect_status w1 '.state' lost "run/a killed pane is lost"
  out="$("$r" resume --all 2>&1)"
  if wait_for w1 "resume=$("$r" status w1 | jq -r '.sessions[0].session_id')"; then
    pass "run/resume --all resumes the same claude session"
  else
    fail "run/resume --all resumes the same claude session" "pane shows" "$out$("$r" log w1 2>&1)"
  fi

  "$r" say w1 exit
  sleep 0.5
  expect_status w1 '[.state, .exit_code] | tostring' '["exited",7]' "run/an ended command reports its exit code"
  "$r" say w1 hi 2>/dev/null && code=0 || code=$?
  expect_code 5 "$code" "run/say refuses a dead pane (5)"

  mkdir -p "$dir/plain" "$dir/trusted"
  "$r" start w2 --dir "$dir/plain" --env FAKE_TRUST=1 --prompt "after trust" -- "$fake" >/dev/null
  wait_for w2 "Quick safety check" || true
  sleep 0.5
  "$r" say w2 hi 2>/dev/null && code=0 || code=$?
  if [[ $("$r" status w2 | jq -c '.sessions[0] | [.dialog, .prompt_pending]') == '["trust",true]' ]] && ((code == 5)); then
    pass "run/a trust dialog shows in status and holds the prompt and say (5)"
  else
    fail "run/a trust dialog shows in status and holds the prompt and say (5)" "say exit $code" "$("$r" status w2)$("$r" log w2)"
  fi

  "$r" start w3 --trust --dir "$dir/trusted" --env FAKE_TRUST=1 --prompt "after trust" -- "$fake" >/dev/null
  if wait_for w3 "got: after trust"; then
    pass "run/--trust answers the dialog, then the prompt goes in"
  else
    fail "run/--trust answers the dialog, then the prompt goes in" "pane shows" "$("$r" log w3 2>&1)"
  fi
  "$r" stop w3

  mkdir -p "$dir/added" "$dir/extra1" "$dir/extra2"
  "$r" start w4 --dir "$dir/added" --env FAKE_TRUST=1 -- "$fake" --add-dir "$dir/extra1" "$dir/extra2" >/dev/null
  wait_for w4 "Quick safety check" || true
  "$r" keys w4 Down Enter
  wait_for w4 "Adding a new directory" || true
  sleep 0.5
  expect_status w4 '.dialog' trust "run/an --add-dir dialog shows in status as trust"
  "$r" stop w4
  "$r" start w5 --trust --dir "$dir/added" --env FAKE_TRUST=1 --prompt "after dirs" -- "$fake" --add-dir "$dir/extra1" "$dir/extra2" >/dev/null
  if wait_for w5 "got: after dirs" || wait_for w5 "got: after dirs"; then
    pass "run/--trust answers each --add-dir dialog, then the prompt goes in"
  else
    fail "run/--trust answers each --add-dir dialog, then the prompt goes in" "pane shows" "$("$r" log w5 2>&1)"
  fi
  "$r" stop w5

  "$r" stop w2
  "$r" status w1 >/dev/null
  "$r" resume --all >/dev/null 2>&1
  expect_status w2 '.state' stopped "run/resume --all skips a stopped session"
  # --agent, through tests/run/fake-agent-wrapper and a conf of our own.
  mkdir -p "$dir/agent-state" "$dir/work/repo--a1"
  printf 'BOX_USER=%s\nAGENT_USER=%s\nGROUP=%s\nWORK=%s\nSTATE=%s\n' "$(id -un)" "$(id -un)" "$(id -gn)" \
    "$dir/work" "$dir/agent-state" >"$dir/tk-agent.conf"
  export DEVBOX_RUN_AGENT_CONF="$dir/tk-agent.conf" DEVBOX_RUN_AGENT_EXEC="$ROOT/tests/run/fake-agent-wrapper"
  "$r" start a0 --agent --dir "$dir/work/repo--a1" --env FOO=bar -- "$fake" >/dev/null 2>&1 && code=0 || code=$?
  expect_code 2 "$code" "run/--agent refuses a non-TICKET_ --env (2)"
  "$r" start a1 --agent --account work --dir "$dir/work/repo--a1" --env TICKET_X=7 --prompt "agent brief" -- "$fake" >/dev/null
  if wait_for a1 "got: agent brief" && "$r" log a1 | grep -q 'AGENT=yes TICKET_X=7' &&
    [[ -s $dir/agent-state/devbox-run/a1/session.json ]] &&
    [[ $("$r" status a1 | jq -r '.sessions[0] | "\(.agent) \(.last_turn) \(.command[1:3] | join(" "))"') == "$(id -un) assistant_done --account work" ]]; then
    pass "run/--agent runs claude through the wrapper, hooks in the shared state dir"
  else
    fail "run/--agent runs claude through the wrapper, hooks in the shared state dir" "pane shows" "$("$r" log a1 2>&1)$("$r" status a1)"
  fi
  tmux -L "$DEVBOX_RUN_SOCKET" kill-session -t =a1
  "$r" resume a1 >/dev/null
  if wait_for a1 "resume=$("$r" status a1 | jq -r '.sessions[0].session_id') FOO= CLAUDECODE=unset AGENT=yes"; then
    pass "run/--agent resumes through the wrapper"
  else
    fail "run/--agent resumes through the wrapper" "pane shows" "$("$r" log a1 2>&1)"
  fi
  "$r" stop a1
  "$r" forget a1
  if [[ ! -e $dir/agent-state/devbox-run/a1 ]]; then
    pass "run/forget removes an agent session's shared files"
  else
    fail "run/forget removes an agent session's shared files" "still there"
  fi

  "$r" status 99 >/dev/null 2>&1 && code=0 || code=$?
  expect_code 3 "$code" "run/status of an unknown name (3)"
}

for s in "${SECTIONS[@]}"; do
  "check_$s"
done

printf 'devbox-check: %d passed, %d failed\n' "$passed" "$failed"
((failed == 0))
